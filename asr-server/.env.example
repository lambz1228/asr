# 数据库：开发用 SQLite；生产改为 postgresql+asyncpg://user:pass@host:5432/asr
DATABASE_URL=sqlite+aiosqlite:///./asr.db

# 对象存储：local（本地目录）| s3（S3 / MinIO 兼容）
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data

# 切换到 MinIO / S3 时填下面几项
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=asr-audio
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin

# FFmpeg / FFprobe
FFMPEG_ENABLED=true
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# 鉴权
# 生产必须用强随机值（例如 openssl rand -hex 32 生成），切勿提交到代码仓库。
# 生产环境建议通过密钥管理服务（Vault / 云 KMS / 容器 Secret）注入，而非明文 .env。
JWT_SECRET=change-me-in-production

# 微信登录：不填则走开发态 mock 登录（固定用户 u_demo）
# 生产必须配置真实 AppID / Secret，并关闭 DEV_MOCK_LOGIN
# WX_APPID=
# WX_SECRET=
DEV_MOCK_LOGIN=true

# 管理员引导：逗号分隔的 openid 列表；命中者在首次微信登录时自动获得 admin 角色。
# 用于初始化首位管理员，之后角色调整走 POST /api/admin/users/{id}/role
# BOOTSTRAP_ADMIN_OPENIDS=oXXXX,oYYYY

# 运行环境：dev | prod。prod 下会强制校验 JWT_SECRET / WX_* / DEV_MOCK_LOGIN，缺失则启动失败
# 注：dev 会额外装配真机录音验证接口 /api/dev/audio-probe（工装用），prod 不暴露
ENV=dev

# 是否自动播种演示数据（生产务必关闭）
SEED_DEMO=true
