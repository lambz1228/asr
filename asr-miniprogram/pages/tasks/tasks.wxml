<view class="container">
  <view wx:if="{{canManage}}" class="review-entry" bindtap="onEnterConsole">
    进入管理台 ›
  </view>

  <!-- 我的进度 -->
  <view wx:if="{{progress && progress.total}}" class="progress-card">
    <view class="progress-head">
      <text class="progress-title">我的进度</text>
      <text class="progress-rate">{{progress.approved}}/{{progress.total}} 已通过 · {{percent}}%</text>
    </view>
    <view class="bar"><view class="bar-fill" style="width:{{percent}}%"></view></view>
    <view class="progress-meta">
      <text>待录 {{progress.pending}}</text>
      <text>待审 {{progress.uploaded}}</text>
      <text class="ok">已通过 {{progress.approved}}</text>
      <text class="{{progress.rejected ? 'bad' : ''}}">已退回 {{progress.rejected}}</text>
    </view>
  </view>

  <view class="section-title">我的任务</view>
  <view wx:if="{{loading}}" class="tip">加载中...</view>
  <view
    wx:for="{{tasks}}"
    wx:key="id"
    class="card"
    data-id="{{item.id}}"
    data-text="{{item.text}}"
    data-version="{{item.version}}"
    bindtap="onTapTask"
  >
    <view class="status">{{statusText[item.status] || item.status}}</view>
    <view class="text">{{item.text}}</view>
    <view wx:if="{{item.status === 'rejected'}}" class="reject">
      <text class="reject-title">退回原因</text>
      <text class="reject-body">{{item.rejectReason || '未填写'}}，请点击重录</text>
    </view>
  </view>
  <view wx:if="{{!loading && tasks.length === 0}}" class="tip">暂无任务</view>

  <block wx:if="{{pool.length}}">
    <view class="section-title">公共池（可领取）</view>
    <view wx:for="{{pool}}" wx:key="id" class="card pool-card">
      <view class="text">{{item.text}}</view>
      <button
        class="claim-btn"
        size="mini"
        loading="{{claiming === item.id}}"
        data-id="{{item.id}}"
        bindtap="onClaim"
      >领取</button>
    </view>
  </block>
</view>
