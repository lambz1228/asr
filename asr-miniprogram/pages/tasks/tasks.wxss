.container {
  padding: 20rpx;
}

/* 个人中心入口 */
.me-row {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 14rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 20rpx;
}
.me-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #e8f3ff;
  color: #1a8cff;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 76rpx;
  text-align: center;
  flex-shrink: 0;
}
.me-main {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}
.me-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.me-role {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #9aa0a6;
}
.me-enter {
  flex-shrink: 0;
  font-size: 25rpx;
  color: #1a8cff;
}
.review-entry {
  background: #07c160;
  color: #fff;
  font-size: 28rpx;
  text-align: center;
  padding: 22rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}
.section-title {
  margin: 24rpx 4rpx 14rpx;
  font-size: 26rpx;
  color: #666;
}

/* 个人进度 */
.progress-card {
  background: #fff;
  border-radius: 14rpx;
  padding: 24rpx;
  margin-bottom: 8rpx;
}
.progress-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.progress-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}
.progress-rate {
  font-size: 24rpx;
  color: #07c160;
}
.bar {
  height: 14rpx;
  background: #eee;
  border-radius: 7rpx;
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  background: #07c160;
  border-radius: 7rpx;
  transition: width 0.3s;
}
.progress-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-top: 16rpx;
  font-size: 23rpx;
  color: #888;
}
.progress-meta .ok {
  color: #07c160;
}
.progress-meta .bad {
  color: #e64340;
}
.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.pool-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.pool-card .text {
  flex: 1;
  min-width: 0;
}
.claim-btn {
  background: #07c160;
  color: #fff;
  flex-shrink: 0;
}
.status {
  font-size: 22rpx;
  color: #888;
  margin-bottom: 8rpx;
}
.text {
  font-size: 30rpx;
}
.reject {
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  background: #fff3f3;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.reject-title {
  font-size: 22rpx;
  color: #e64340;
}
.reject-body {
  font-size: 25rpx;
  color: #8a3b39;
  line-height: 1.5;
}
.tip {
  text-align: center;
  color: #999;
  margin-top: 60rpx;
}
