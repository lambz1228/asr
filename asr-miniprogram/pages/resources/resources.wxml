<view class="page">
  <view class="hero">
    <view class="hero-title">学习资源</view>
    <view class="hero-sub">
      <text class="role-tag {{isManager ? 'mgr' : 'col'}}">{{roleText}}</text>
      <text>· 采集规范与朗读素材</text>
    </view>
  </view>

  <!-- 录音规范 -->
  <view class="section-title">录音规范</view>
  <view class="rule-grid">
    <view class="rule" wx:for="{{rules}}" wx:key="title">
      <view class="rule-ico">{{item.icon}}</view>
      <view class="rule-title">{{item.title}}</view>
      <view class="rule-desc">{{item.desc}}</view>
    </view>
  </view>

  <!-- 采集前自检 -->
  <view class="section-title">采集前自检</view>
  <view class="card">
    <block wx:if="{{isCollector}}">
      <view class="check-row" bindtap="onGoConsent">
        <text class="check-dot {{consentSigned ? 'ok' : 'todo'}}">{{consentSigned ? '✓' : '!'}}</text>
        <view class="check-body">
          <view class="check-title">《语音信息同意书》</view>
          <view class="check-desc">{{consentSigned ? '已签署，可正常上传' : '未签署，上传会被拦截，点击前往签署'}}</view>
        </view>
        <text class="check-arrow">›</text>
      </view>
    </block>
    <view class="check-row" bindtap="onPrivacy">
      <text class="check-dot ok">?</text>
      <view class="check-body">
        <view class="check-title">微信《用户隐私保护指引》</view>
        <view class="check-desc">录音前需通过微信平台隐私授权，点击查看协议</view>
      </view>
      <text class="check-arrow">›</text>
    </view>
    <view wx:if="{{isManager}}" class="check-row" bindtap="onReview">
      <text class="check-dot ok">✓</text>
      <view class="check-body">
        <view class="check-title">录音审核台</view>
        <view class="check-desc">试听并判定通过 / 退回，退回原因会回显给采集员</view>
      </view>
      <text class="check-arrow">›</text>
    </view>
  </view>

  <!-- 文本库（采集员） -->
  <block wx:if="{{isCollector}}">
    <view class="section-head">
      <text class="section-title">我的文本库</text>
      <text class="section-more">{{filtered.length}}/{{texts.length}} 条</text>
    </view>
    <view class="search">
      <text class="search-ico">🔍</text>
      <input
        class="search-input"
        value="{{keyword}}"
        placeholder="搜索文本内容，点条目直接去录"
        confirm-type="search"
        bindinput="onKeyword"
      />
      <text wx:if="{{keyword}}" class="search-clear" bindtap="clearKeyword">✕</text>
    </view>
    <view wx:if="{{loading}}" class="tip">加载中...</view>
    <view
      wx:for="{{filtered}}"
      wx:key="id"
      class="card text-card"
      data-id="{{item.id}}"
      bindtap="onTapText"
    >
      <view class="text-line">{{item.text}}</view>
      <text class="status {{item.status}}">{{statusText[item.status] || item.status}}</text>
    </view>
    <view wx:if="{{!loading && !filtered.length}}" class="tip">
      {{texts.length ? '没有匹配的文本' : '暂无文本，等待管理员下发任务'}}
    </view>
  </block>

  <!-- 常见退回原因 -->
  <view class="section-title">常见退回原因</view>
  <view class="card faq">
    <view wx:for="{{faq}}" wx:key="q" class="faq-item" data-i="{{index}}" bindtap="onToggleFaq">
      <view class="faq-q">
        <text class="faq-mark">{{openFaq === index ? '−' : '+'}}</text>
        <text>{{item.q}}</text>
      </view>
      <view wx:if="{{openFaq === index}}" class="faq-a">{{item.a}}</view>
    </view>
  </view>

  <!-- 管理员专属 -->
  <block wx:if="{{isManager}}">
    <view class="section-title">导入格式说明</view>
    <view class="card">
      <view class="fmt-desc">Excel/CSV 仅需两列：序号 + 汉语文本。序号不参与采集，只用于定位；每行一条句子。</view>
      <view class="fmt-table">
        <view class="fmt-row head">
          <text class="fmt-c1">序号</text>
          <text class="fmt-c2">汉语文本</text>
        </view>
        <view class="fmt-row">
          <text class="fmt-c1">1</text>
          <text class="fmt-c2">今天天气很好，我们一起去公园散步。</text>
        </view>
        <view class="fmt-row">
          <text class="fmt-c1">2</text>
          <text class="fmt-c2">请把窗户关上，外面风有点大。</text>
        </view>
      </view>
      <button class="btn-line" bindtap="onCopyTemplate">复制模板示例</button>
    </view>

    <view class="section-title">上线前检查项</view>
    <view class="card">
      <view class="li">· 小程序后台配置 request 合法域名（后端需 HTTPS）</view>
      <view class="li">· 隐私协议中勾选「麦克风」权限说明</view>
      <view class="li">· 导出数据集时确认已勾选完整性校验（manifest.json）</view>
      <view class="li">· 导出包默认保留 7 天，可在审计日志页手动清理</view>
    </view>
  </block>

  <view class="footer">ASR 语音采集 · 两个身份共用同一套导航与规范</view>
</view>
