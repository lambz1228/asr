<view class="page {{anim}}">
  <!-- ==================== 顶部 ==================== -->
  <view class="hero">
    <view class="hero-blob hero-blob1"></view>
    <view class="hero-blob hero-blob2"></view>
    <view class="hero-row">
      <view class="hero-main">
        <view class="hero-hi">学习资源</view>
        <view class="hero-sub">
          <text class="role-tag">{{roleText}}</text>
          <text class="hero-hint">录音规范 · 朗读素材</text>
        </view>
      </view>
      <view class="hero-emoji">📖</view>
    </view>
  </view>

  <!-- ==================== 录音规范 ==================== -->
  <view class="sec-head">
    <view class="sec-title"><view class="sec-bar"></view><text>录音规范</text></view>
  </view>
  <view class="rules">
    <view class="rule" wx:for="{{rules}}" wx:key="title">
      <view class="rule-ico">{{item.icon}}</view>
      <view class="rule-title">{{item.title}}</view>
      <view class="rule-desc">{{item.desc}}</view>
    </view>
  </view>

  <!-- ==================== 采集前自检 ==================== -->
  <view class="sec-head">
    <view class="sec-title"><view class="sec-bar green"></view><text>采集前自检</text></view>
  </view>
  <view class="list">
    <view
      wx:if="{{isCollector}}"
      class="row"
      hover-class="row-press"
      hover-stay-time="60"
      bindtap="onGoConsent"
    >
      <text class="dot {{consentSigned ? 'ok' : 'todo'}}">{{consentSigned ? '✓' : '!'}}</text>
      <view class="row-body">
        <view class="row-title">《语音信息同意书》</view>
        <view class="row-desc">{{consentSigned ? '已签署，可正常上传' : '未签署，上传会被拦截，点击前往签署'}}</view>
      </view>
      <text class="row-arrow">›</text>
    </view>
    <view class="row" hover-class="row-press" hover-stay-time="60" bindtap="onPrivacy">
      <text class="dot info">?</text>
      <view class="row-body">
        <view class="row-title">微信《用户隐私保护指引》</view>
        <view class="row-desc">录音前需通过微信平台隐私授权，点击查看协议</view>
      </view>
      <text class="row-arrow">›</text>
    </view>
  </view>

  <!-- ==================== 文本库（采集员） ==================== -->
  <block wx:if="{{isCollector}}">
    <view class="sec-head">
      <view class="sec-title"><view class="sec-bar violet"></view><text>我的文本库</text></view>
      <text class="sec-more">{{shownCount}}/{{textCount}} 条</text>
    </view>
    <view class="search">
      <text class="search-ico">🔍</text>
      <input
        class="search-input"
        value="{{keyword}}"
        placeholder="搜索文本内容，点条目直接去录"
        placeholder-class="search-ph"
        confirm-type="search"
        bindinput="onKeyword"
      />
      <text wx:if="{{keyword}}" class="search-clear" bindtap="clearKeyword">✕</text>
    </view>
    <view wx:if="{{skeleton}}" class="sk-wrap">
      <view class="sk sk-line"></view>
      <view class="sk sk-line"></view>
      <view class="sk sk-line"></view>
    </view>
    <view
      wx:for="{{filtered}}"
      wx:key="id"
      class="card text-item"
      hover-class="press"
      hover-stay-time="60"
      data-id="{{item.id}}"
      bindtap="onTapText"
    >
      <view class="text-line">{{item.text}}</view>
      <text class="status {{item.status}}">{{statusText[item.status] || item.status}}</text>
    </view>
    <view wx:if="{{!skeleton && !filtered.length}}" class="tip">
      {{textCount ? '没有匹配的文本' : '暂无文本，等待管理员下发任务'}}
    </view>
  </block>

  <!-- ==================== 常见退回原因 ==================== -->
  <view class="sec-head">
    <view class="sec-title"><view class="sec-bar amber"></view><text>常见退回原因</text></view>
  </view>
  <view class="list">
    <view wx:for="{{faq}}" wx:key="q" class="faq" data-i="{{index}}" bindtap="onToggleFaq">
      <view class="faq-q">
        <text class="faq-mark {{openFaq === index ? 'open' : ''}}">{{openFaq === index ? '−' : '+'}}</text>
        <text class="faq-q-text">{{item.q}}</text>
      </view>
      <view wx:if="{{openFaq === index}}" class="faq-a">{{item.a}}</view>
    </view>
  </view>

  <!-- ==================== 管理员专属 ==================== -->
  <!-- 2026-10-12：管理员底部导航已收敛为「任务管理 · 个人中心」，进不来本页，
       故这一整块（导入格式说明 / 复制模板 / 上线前检查项）随之删除 ——
       保留一个够不到的分支比删掉更容易误导后来人。
       审核台入口在「个人中心 → 快捷操作」，导入格式见
       subpackages/admin/import 页与「任务导入格式说明.md」。 -->

  <view class="footer">ASR 语音采集 · 录音规范与采集前自检</view>
</view>
