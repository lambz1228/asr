.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 20rpx 50rpx;
  background: #f5f6f8;
}

.hero {
  padding: 8rpx 8rpx 4rpx;
}
.hero-title {
  font-size: 42rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.hero-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #999;
  display: flex;
  align-items: center;
}
.role-tag {
  font-size: 22rpx;
  padding: 2rpx 14rpx;
  border-radius: 18rpx;
  margin-right: 12rpx;
}
.role-tag.col {
  color: #1a8cff;
  background: #e8f3ff;
}
.role-tag.mgr {
  color: #8a5a00;
  background: #fff4e0;
}

.section-title {
  margin: 28rpx 8rpx 14rpx;
  font-size: 26rpx;
  color: #666;
}
.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 28rpx 8rpx 14rpx;
}
.section-head .section-title {
  margin: 0;
}
.section-more {
  font-size: 23rpx;
  color: #9aa0a6;
}

/* 录音规范 */
.rule-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.rule {
  width: calc(50% - 8rpx);
  box-sizing: border-box;
  background: #fff;
  border-radius: 16rpx;
  padding: 22rpx 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.rule-ico {
  font-size: 34rpx;
}
.rule-title {
  margin-top: 10rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: #222;
}
.rule-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a8f94;
  line-height: 1.55;
}

/* 自检 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.check-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}
.check-row:last-child {
  border-bottom: none;
}
.check-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  text-align: center;
  line-height: 44rpx;
  font-size: 24rpx;
  flex-shrink: 0;
  color: #fff;
}
.check-dot.ok {
  background: #07c160;
}
.check-dot.todo {
  background: #ff9f0a;
}
.check-body {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}
.check-title {
  font-size: 28rpx;
  color: #222;
}
.check-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9aa0a6;
}
.check-arrow {
  color: #ccc;
  font-size: 34rpx;
  margin-left: 12rpx;
}

/* 搜索 */
.search {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.search-ico {
  font-size: 26rpx;
  margin-right: 12rpx;
}
.search-input {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  color: #222;
}
.search-clear {
  color: #c8ccd0;
  font-size: 26rpx;
  padding: 0 6rpx;
}

/* 文本库 */
.text-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 16rpx;
}
.text-line {
  flex: 1;
  min-width: 0;
  font-size: 29rpx;
  color: #222;
  line-height: 1.5;
}
.status {
  flex-shrink: 0;
  font-size: 20rpx;
  padding: 3rpx 12rpx;
  border-radius: 14rpx;
  color: #666;
  background: #f0f1f3;
}
.status.claimed,
.status.pending {
  color: #1a8cff;
  background: #e8f3ff;
}
.status.uploading,
.status.uploaded {
  color: #d48100;
  background: #fff4e0;
}
.status.approved {
  color: #07c160;
  background: #e8f8ef;
}
.status.rejected {
  color: #e64340;
  background: #ffecec;
}

/* FAQ */
.faq {
  padding: 4rpx 24rpx;
}
.faq-item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}
.faq-item:last-child {
  border-bottom: none;
}
.faq-q {
  display: flex;
  align-items: flex-start;
  font-size: 27rpx;
  color: #222;
}
.faq-mark {
  flex-shrink: 0;
  width: 36rpx;
  color: #1a8cff;
  font-size: 30rpx;
  line-height: 1.3;
}
.faq-a {
  margin: 12rpx 0 4rpx 36rpx;
  font-size: 24rpx;
  color: #7b8085;
  line-height: 1.6;
}

/* 管理员 */
.fmt-desc {
  padding: 20rpx 0 14rpx;
  font-size: 24rpx;
  color: #7b8085;
  line-height: 1.6;
}
.fmt-table {
  border: 1rpx solid #eceef0;
  border-radius: 10rpx;
  overflow: hidden;
}
.fmt-row {
  display: flex;
  font-size: 23rpx;
  color: #555;
  border-bottom: 1rpx solid #eceef0;
}
.fmt-row:last-child {
  border-bottom: none;
}
.fmt-row.head {
  background: #f7f8fa;
  color: #333;
  font-weight: 600;
}
.fmt-c1 {
  width: 90rpx;
  flex-shrink: 0;
  padding: 14rpx 16rpx;
  border-right: 1rpx solid #eceef0;
}
.fmt-c2 {
  flex: 1;
  min-width: 0;
  padding: 14rpx 16rpx;
}
.btn-line {
  margin: 22rpx 0 16rpx;
  background: #fff;
  color: #1a8cff;
  font-size: 27rpx;
  line-height: 2.5;
  border: 1rpx solid #cfe4ff;
  border-radius: 12rpx;
}
.btn-line::after {
  border: none;
}
.li {
  padding: 16rpx 0;
  font-size: 24rpx;
  color: #7b8085;
  line-height: 1.6;
  border-bottom: 1rpx solid #f2f3f5;
}
.li:last-child {
  border-bottom: none;
}

.tip {
  text-align: center;
  color: #9aa0a6;
  font-size: 25rpx;
  margin: 36rpx 0;
}
.footer {
  margin-top: 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b0b4b8;
}
