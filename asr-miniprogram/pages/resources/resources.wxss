.page {
  min-height: 100vh;
  box-sizing: border-box;
  /* 拆成三条写：最后一条 calc 若被机型丢弃，仍保留固定底部留白 */
  padding: 24rpx 24rpx 0;
  padding-bottom: var(--tab-pad);
  padding-bottom: calc(var(--tab-pad) + env(safe-area-inset-bottom));
}

/* ============================ 顶部 ============================ */
.hero {
  position: relative;
  overflow: hidden;
  border-radius: var(--r-xl);
  padding: 34rpx 32rpx;
  background: linear-gradient(135deg, var(--brand) 0%, #3ea3ff 52%, #6dc4ff 100%);
  box-shadow: 0 16rpx 40rpx rgba(26, 140, 255, 0.28);
  margin-bottom: 8rpx;
}
.hero-blob {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
}
.hero-blob1 {
  width: 260rpx;
  height: 260rpx;
  right: -80rpx;
  top: -120rpx;
}
.hero-blob2 {
  width: 156rpx;
  height: 156rpx;
  right: 120rpx;
  bottom: -90rpx;
  background: rgba(255, 255, 255, 0.1);
}
.hero-row {
  position: relative;
  display: flex;
  align-items: center;
}
.hero-main {
  flex: 1;
  min-width: 0;
}
.hero-hi {
  font-size: var(--fs-8);
  font-weight: 600;
  color: var(--on-brand);
}
.hero-sub {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
}
.role-tag {
  font-size: var(--fs-1);
  color: var(--on-brand);
  padding: 4rpx 16rpx;
  border-radius: var(--r-pill);
  background: rgba(255, 255, 255, 0.26);
  margin-right: 14rpx;
}
.hero-hint {
  font-size: var(--fs-2);
  color: rgba(255, 255, 255, 0.88);
}
.hero-emoji {
  width: 92rpx;
  height: 92rpx;
  border-radius: var(--r-lg);
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.22);
  font-size: var(--fs-10);
  line-height: 92rpx;
  text-align: center;
}

/* ============================ 分组标题 ============================ */
.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 6rpx 16rpx;
}
.sec-title {
  display: flex;
  align-items: center;
  font-size: var(--fs-5);
  font-weight: 600;
  color: var(--t1);
}
.sec-bar {
  width: 8rpx;
  height: 28rpx;
  border-radius: var(--r-xs);
  background: linear-gradient(180deg, var(--brand-2), var(--brand));
  margin-right: 14rpx;
}
.sec-bar.green {
  background: linear-gradient(180deg, var(--green-2), var(--green));
}
.sec-bar.violet {
  background: linear-gradient(180deg, var(--violet-2), var(--violet));
}
.sec-bar.amber {
  background: linear-gradient(180deg, var(--amber-2), var(--amber));
}
.sec-more {
  font-size: var(--fs-2);
  color: var(--t3);
}

/* ============================ 录音规范 ============================ */
.rules {
  display: flex;
  flex-wrap: wrap;
  /* 不用 gap：老基础库 / iOS 13- 不支持 flex gap */
  justify-content: space-between;
}
.rule {
  /* 纯百分比，不用 calc(50% - 8rpx)：% 与 rpx 混算的取整误差会让
     两列加间距刚好超过 100%，每行只放得下一张卡，退化成单列 */
  width: 48.6%;
  margin-bottom: 18rpx;
  box-sizing: border-box;
  background: var(--card);
  border-radius: var(--r-lg);
  box-shadow: var(--sd);
  padding: 24rpx 22rpx;
  transition: transform 0.16s var(--ease);
}
.rule-ico {
  width: 66rpx;
  height: 66rpx;
  border-radius: var(--r-lg);
  background: linear-gradient(150deg, #eef6ff, #ddeafc);
  font-size: var(--fs-7);
  line-height: 66rpx;
  text-align: center;
}
.rule-title {
  margin-top: 14rpx;
  font-size: var(--fs-4);
  font-weight: 600;
  color: var(--t1);
}
.rule-desc {
  margin-top: 8rpx;
  font-size: var(--fs-2);
  color: var(--t3);
  line-height: 1.55;
}

/* ============================ 通用列表 ============================ */
.list {
  background: var(--card);
  border-radius: var(--r-lg);
  box-shadow: var(--sd);
  overflow: hidden;
}
.row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid var(--line);
  transition: background 0.16s var(--ease);
}
.row:last-child {
  border-bottom: none;
}
.row-press {
  background: var(--surface-2);
}
.dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  flex-shrink: 0;
  text-align: center;
  line-height: 48rpx;
  font-size: var(--fs-3);
  font-weight: 600;
  color: var(--on-brand);
  background: linear-gradient(135deg, var(--green-2), var(--green));
  box-shadow: var(--sd-green);
}
.dot.ok {
  background: linear-gradient(135deg, var(--green-2), var(--green));
  box-shadow: var(--sd-green);
}
.dot.todo {
  background: linear-gradient(135deg, var(--amber-2), var(--amber));
  box-shadow: var(--sd-amber);
  animation: pulseDot 1.7s ease-in-out infinite;
}
.dot.info {
  background: linear-gradient(135deg, var(--brand-lt), var(--brand));
  box-shadow: var(--sd-brand);
}
.row-body {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}
.row-title {
  font-size: var(--fs-5);
  color: var(--t1);
}
.row-desc {
  margin-top: 6rpx;
  font-size: var(--fs-2);
  color: var(--t3);
  line-height: 1.45;
}
.row-arrow {
  color: var(--t4);
  font-size: var(--fs-8);
  margin-left: 12rpx;
}

/* ============================ 搜索 ============================ */
.search {
  display: flex;
  align-items: center;
  background: var(--card);
  border-radius: var(--r-lg);
  box-shadow: var(--sd);
  padding: 18rpx 22rpx;
  margin-bottom: 16rpx;
}
.search-ico {
  font-size: var(--fs-4);
  margin-right: 12rpx;
}
.search-input {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-4);
  color: var(--t1);
}
.search-ph {
  color: var(--t4);
}
.search-clear {
  color: var(--t3);
  font-size: var(--fs-4);
  padding: 0 8rpx;
}

/* ============================ 文本条目 ============================ */
.text-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
  transition: transform 0.16s var(--ease);
}
.text-line {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-5);
  color: var(--t1);
  line-height: 1.5;
  margin-right: 18rpx;
}
.status {
  flex-shrink: 0;
  font-size: var(--fs-1);
  padding: 4rpx 14rpx;
  border-radius: var(--r-xs);
  color: var(--t2);
  background: var(--surface-2);
}
.status.claimed,
.status.pending {
  color: var(--brand);
  background: var(--brand-soft);
}
.status.uploading,
.status.uploaded {
  color: var(--amber-ink);
  background: var(--amber-soft);
}
.status.approved {
  color: var(--green);
  background: var(--green-soft);
}
.status.rejected {
  color: var(--red);
  background: var(--red-soft);
}

/* ============================ FAQ ============================ */
.faq {
  padding: 24rpx;
  border-bottom: 1rpx solid var(--line);
}
.faq:last-child {
  border-bottom: none;
}
.faq-q {
  display: flex;
  align-items: flex-start;
}
.faq-mark {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  text-align: center;
  line-height: 40rpx;
  font-size: var(--fs-5);
  color: var(--brand);
  background: var(--brand-soft);
  margin-right: 16rpx;
  transition: transform 0.28s var(--ease), background 0.28s var(--ease);
}
.faq-mark.open {
  transform: rotate(180deg);
  background: var(--brand-soft);
}
.faq-q-text {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-4);
  color: var(--t1);
  line-height: 1.5;
}
.faq-a {
  margin: 14rpx 0 4rpx 56rpx;
  font-size: var(--fs-3);
  color: var(--t2);
  line-height: 1.65;
  animation: slideDown 0.28s cubic-bezier(0.22, 0.9, 0.32, 1) backwards;
}

/* ============================ 说明块 ============================ */
.block {
  padding: 24rpx;
}
.block-desc {
  font-size: var(--fs-3);
  color: var(--t2);
  line-height: 1.6;
}
.fmt {
  margin-top: 18rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--r-sm);
  overflow: hidden;
}
.fmt-row {
  display: flex;
  font-size: var(--fs-2);
  color: var(--t2);
  border-bottom: 1rpx solid var(--line);
}
.fmt-row:last-child {
  border-bottom: none;
}
.fmt-row.head {
  background: var(--surface-2);
  color: var(--t1);
  font-weight: 600;
}
.fmt-c1 {
  width: 90rpx;
  flex-shrink: 0;
  padding: 14rpx 16rpx;
  border-right: 1rpx solid var(--line);
}
.fmt-c2 {
  flex: 1;
  min-width: 0;
  padding: 14rpx 16rpx;
}
.btn-line {
  margin: 22rpx 0 4rpx;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: var(--fs-4);
  line-height: 2.5;
  border-radius: var(--r-sm);
  transition: transform 0.16s var(--ease);
}
.btn-line::after {
  border: none;
}
.li {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  font-size: var(--fs-3);
  color: var(--t2);
  line-height: 1.6;
  border-bottom: 1rpx solid var(--line);
}
.li:last-child {
  border-bottom: none;
}
.li-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--brand);
  margin: 14rpx 14rpx 0 0;
  flex-shrink: 0;
}

/* ============================ 加载 / 空态 ============================ */
.sk-wrap {
  display: flex;
  flex-direction: column;
}
.sk-wrap > view + view {
  margin-top: 16rpx;
}
.sk-line {
  height: 108rpx;
  border-radius: var(--r-lg);
}
.tip {
  text-align: center;
  color: var(--t3);
  font-size: var(--fs-3);
  margin: 36rpx 0;
}
.footer {
  margin: 40rpx 0 0;
  text-align: center;
  font-size: var(--fs-2);
  color: var(--t4);
}
