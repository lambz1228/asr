page {
  background: #eef1f6;
}
.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 28rpx calc(300rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

.header {
  padding: 16rpx 4rpx 22rpx;
}
.title {
  font-size: 38rpx;
  font-weight: 600;
  color: var(--t1);
}
.subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--red);
}

.doc {
  flex: 1;
  background: var(--card);
  border-radius: var(--r-lg);
  box-shadow: var(--sd);
  padding: 26rpx;
}
.doc-section {
  margin-bottom: 24rpx;
}
.doc-h {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t1);
  margin-bottom: 10rpx;
}
.doc-p {
  font-size: 27rpx;
  line-height: 1.7;
  color: var(--t2);
}
.emph {
  color: var(--red);
  font-weight: 600;
}

.privacy-link {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0 4rpx;
  font-size: 25rpx;
  color: #576b95;
}
.privacy-link .arrow {
  margin-left: 6rpx;
  font-size: 30rpx;
  line-height: 1;
}

.agree-row {
  margin: 22rpx 4rpx;
}
.agree-label {
  display: flex;
  align-items: center;
  font-size: 27rpx;
  color: var(--t1);
}

/* 底部固定操作条 */
.actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(238, 241, 246, 0.96);
  box-shadow: 0 -8rpx 28rpx rgba(20, 33, 56, 0.07);
}
.btn-primary {
  width: 100%;
  height: 100rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-lg);
  background: linear-gradient(135deg, #20d47a, #07c160);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 14rpx 32rpx rgba(7, 193, 96, 0.28);
  transition: transform 0.18s var(--ease);
}
.btn-primary::after {
  border: none;
}
.btn-primary[disabled] {
  background: #b7e4cb;
  color: #fff;
  box-shadow: none;
}
.btn-row {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
}
.btn-ghost {
  flex: 1;
  height: 84rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card);
  color: var(--t1);
  border-radius: var(--r-lg);
  font-size: 28rpx;
  box-shadow: var(--sd);
  transition: transform 0.18s var(--ease);
}
.btn-ghost::after {
  border: none;
}
.btn-ghost.danger {
  color: var(--red);
}
.btn-press {
  transform: scale(0.975);
}
