.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 28rpx calc(180rpx + env(safe-area-inset-bottom));
  background: #f5f5f5;
  display: flex;
  flex-direction: column;
}

.header {
  padding: 16rpx 4rpx 20rpx;
}
.title {
  font-size: 38rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #e64340;
}

.doc {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.doc-section {
  margin-bottom: 24rpx;
}
.doc-h {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 10rpx;
}
.doc-p {
  font-size: 27rpx;
  line-height: 1.7;
  color: #555;
}
.emph {
  color: #e64340;
  font-weight: 600;
}

.privacy-link {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 0 4rpx;
  font-size: 25rpx;
  color: #576b95;
}
.privacy-link .arrow {
  margin-left: 6rpx;
  font-size: 30rpx;
  line-height: 1;
}

.agree-row {
  margin: 20rpx 4rpx;
}
.agree-label {
  display: flex;
  align-items: center;
  font-size: 27rpx;
  color: #333;
}

.actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #f5f5f5;
}
.btn-primary {
  background: #07c160;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
}
.btn-primary[disabled] {
  background: #9ed9b6;
  color: #fff;
}
.btn-row {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
}
.btn-ghost {
  flex: 1;
  background: #fff;
  color: #333;
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  font-size: 28rpx;
}
.btn-ghost.danger {
  color: #e64340;
  border-color: #f0c2c0;
}
