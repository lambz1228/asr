<view class="page">
  <!-- ==================== 顶部：队列切换 ==================== -->
  <view wx:if="{{total}}" class="pager">
    <view
      class="pg-arrow {{index <= 0 ? 'disabled' : ''}}"
      hover-class="pg-arrow-press"
      hover-stay-time="60"
      bindtap="onPrev"
    >‹</view>
    <view class="pg-mid">
      <view class="pg-count">
        <text class="pg-cur">{{index + 1}}</text>
        <text class="pg-all">/ {{total}}</text>
      </view>
      <view class="pg-track">
        <view class="pg-fill" style="width:{{(index + 1) / total * 100}}%"></view>
      </view>
    </view>
    <view
      class="pg-arrow {{index >= total - 1 ? 'disabled' : ''}}"
      hover-class="pg-arrow-press"
      hover-stay-time="60"
      bindtap="onNext"
    >›</view>
  </view>

  <!-- 加载骨架 -->
  <view wx:if="{{skeleton}}" class="sk-wrap">
    <view class="sk sk-text"></view>
    <view class="sk sk-meta"></view>
    <view class="sk sk-panel"></view>
  </view>

  <!-- 空态：没有可采集的任务 -->
  <view wx:if="{{!skeleton && empty}}" class="empty">
    <view class="empty-ico-wrap"><text class="empty-ico">🎙</text></view>
    <view class="empty-title">暂无可采集任务</view>
    <view class="empty-desc">等待管理员下发任务，或到「首页 · 公共池」领取</view>
    <button class="btn primary" hover-class="btn-press" bindtap="onGoHome">去首页看看</button>
  </view>

  <block wx:if="{{current}}">
    <!-- ==================== 待录文本（切换任务时滑入） ==================== -->
    <view class="{{slideCls}}">
      <view class="text-card">
        <view class="text-accent"></view>
        <view class="text-quote">“</view>
        <view class="text-main">{{current.text}}</view>
        <view wx:if="{{current.textId}}" class="text-id">编号 {{current.textId}}</view>
      </view>

      <view class="meta-bar">
        <view class="meta-cell">
          <text class="meta-k">当前发音人</text>
          <text class="meta-v">{{speaker || '—'}}</text>
        </view>
        <view class="meta-div"></view>
        <view class="meta-cell">
          <text class="meta-k">任务包</text>
          <text class="meta-v">{{current.pkgName || '未命名任务包'}}</text>
        </view>
      </view>

      <!-- 退回原因 -->
      <view wx:if="{{current.rejectReason}}" class="reject-bar">
        <text class="bar-title">退回原因</text>
        <text class="bar-text">{{current.rejectReason}}</text>
      </view>

      <!-- 重录替换警告（仅当该任务此前已录过） -->
      <view wx:if="{{replacing}}" class="warn-bar">点击录音并保存，会替换之前的录音</view>

      <!-- 中断告警 -->
      <view wx:if="{{interrupted}}" class="alert">
        该录音在录制过程中被打断（来电 / 切后台），内容可能不完整，建议「清除重录」
      </view>
    </view>

    <!-- ==================== 录音区 ==================== -->
    <view class="rec-panel {{recording ? (paused ? 'paused' : 'on') : ''}}">
      <view class="rec-timer">{{timerText}}</view>
      <view wx:if="{{toast}}" class="rec-toast">{{toast}}</view>

      <view class="rec-btn-wrap">
        <view class="rec-halo"></view>
        <view wx:if="{{recording && !paused}}" class="ripple r1"></view>
        <view wx:if="{{recording && !paused}}" class="ripple r2"></view>
        <view
          class="rec-ring {{recording ? 'recording' : ''}}"
          hover-class="rec-ring-press"
          hover-stay-time="60"
          bindtap="onToggleRecord"
        >
          <view class="rec-btn {{recording ? 'stop' : ''}}">
            <view class="rec-dot" wx:if="{{!recording}}"></view>
            <view class="rec-square" wx:else></view>
          </view>
        </view>
      </view>

      <!-- 录制中的律动波形 -->
      <view class="wave {{recording && !paused ? 'live' : ''}}">
        <view class="wv w1"></view>
        <view class="wv w2"></view>
        <view class="wv w3"></view>
        <view class="wv w4"></view>
        <view class="wv w5"></view>
        <view class="wv w6"></view>
        <view class="wv w7"></view>
      </view>

      <view class="rec-label">{{recLabel}}</view>
    </view>

    <view wx:if="{{statusText}}" class="status {{interrupted ? 'warn' : ''}}">{{statusText}}</view>

    <!-- 录制中：暂停 / 继续 -->
    <view wx:if="{{recording}}" class="row">
      <button class="btn ghost" hover-class="btn-press" bindtap="onTogglePause">
        {{paused ? '继续录音' : '暂停'}}
      </button>
    </view>

    <!-- 已录完：试听 / 清除重录 / 保存提交 -->
    <block wx:if="{{recorded}}">
      <view class="row">
        <button class="btn ghost" hover-class="btn-press" bindtap="onPlay">
          {{playing ? '停止播放' : '试听'}}
        </button>
        <button class="btn ghost" hover-class="btn-press" bindtap="onRerecord">清除重录</button>
      </view>
      <button class="btn primary" hover-class="btn-press" bindtap="onSubmit">保存并提交</button>
    </block>
  </block>
</view>
