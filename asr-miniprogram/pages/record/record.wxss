.container {
  padding: 40rpx;
}
.text-box {
  background: #fff;
  border-radius: 12rpx;
  padding: 32rpx;
  font-size: 32rpx;
  line-height: 1.6;
  margin-bottom: 30rpx;
}
.status {
  color: #666;
  font-size: 26rpx;
  margin-bottom: 30rpx;
}
.status.warn {
  color: #e64340;
}
.alert {
  background: #fff3f3;
  color: #8a3b39;
  border-radius: 10rpx;
  padding: 20rpx 24rpx;
  font-size: 25rpx;
  line-height: 1.5;
  margin-bottom: 28rpx;
}
.ctrl {
  margin-bottom: 20rpx;
}
.ctrl.primary {
  background: #07c160;
  color: #fff;
}
.ctrl.danger {
  background: #e64340;
  color: #fff;
}
