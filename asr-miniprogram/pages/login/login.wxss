page {
  background: var(--bg);
}
.page {
  position: relative;
  overflow: hidden;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 110rpx 44rpx 60rpx;
  background: linear-gradient(180deg, #e9f3ff 0%, #f4f8fd 44%, var(--bg) 100%);
}

/* 背景装饰光斑 */
.bg-blob {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}
.bg1 {
  width: 420rpx;
  height: 420rpx;
  right: -140rpx;
  top: -160rpx;
  background: radial-gradient(circle, rgba(26, 140, 255, 0.22), rgba(26, 140, 255, 0));
  animation: breathe 6s ease-in-out infinite;
}
.bg2 {
  width: 320rpx;
  height: 320rpx;
  left: -120rpx;
  top: 200rpx;
  background: radial-gradient(circle, rgba(124, 92, 255, 0.16), rgba(124, 92, 255, 0));
  animation: breathe 7.5s ease-in-out infinite;
}
.bg3 {
  width: 380rpx;
  height: 380rpx;
  right: -120rpx;
  bottom: -120rpx;
  background: radial-gradient(circle, rgba(7, 193, 96, 0.14), rgba(7, 193, 96, 0));
  animation: breathe 8.4s ease-in-out infinite;
}

/* 品牌区 */
.brand {
  position: relative;
  text-align: center;
  animation: riseIn 0.5s cubic-bezier(0.22, 0.9, 0.32, 1) backwards;
}
/* 品牌标：话筒 + 支架，纯 CSS 绘制（零位图、零体积、零版权风险，且跟随令牌变色）。
   几何是手工在 136rpx 方块里对位的，纵向预算如下（改尺寸请同步平移，不要只改一处）：
     话筒 29~81   U 形支架 42~88（下边线 83~88）   支杆 88~100   底座 100~107
   内容整体 29~107，中心 68 = 方块中心。 */
.logo {
  position: relative;
  width: 136rpx;
  height: 136rpx;
  margin: 0 auto;
  border-radius: var(--r-xl);
  background: linear-gradient(135deg, var(--brand-lt), var(--brand));
  box-shadow: 0 18rpx 40rpx rgba(26, 140, 255, 0.34);
  animation: popIn 0.62s cubic-bezier(0.22, 0.9, 0.32, 1) backwards;
}
/* 顶部柔光：压在底色之上、图形之下，给方块一点体积感 */
.logo::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 52%;
  border-radius: var(--r-xl) var(--r-xl) 0 0;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0));
}
/* 话筒本体：上宽下略收的白胶囊 */
.logo-body {
  position: absolute;
  left: 50%;
  top: 29rpx;
  margin-left: -14rpx;
  width: 28rpx;
  height: 52rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 10rpx;
  border-radius: var(--r-sm);
  background: linear-gradient(180deg, var(--on-brand), rgba(255, 255, 255, 0.86));
}
/* 网罩横缝：透出底色蓝，形成格栅。三条等距，靠 padding-bottom 略向上偏 */
.logo-slit {
  width: 18rpx;
  height: 4rpx;
  border-radius: var(--r-pill);
  background: rgba(26, 140, 255, 0.38);
}
.logo-slit + .logo-slit {
  margin-top: 6rpx;
}
/* U 形支架：只留左右与下边，环绕话筒下半部 */
.logo-yoke {
  position: absolute;
  left: 50%;
  top: 42rpx;
  margin-left: -34rpx;
  width: 68rpx;
  height: 46rpx;
  box-sizing: border-box;
  border: 5rpx solid rgba(255, 255, 255, 0.92);
  border-top: 0;
  border-radius: 0 0 var(--r-lg) var(--r-lg);
}
/* 支杆与底座 */
.logo-neck {
  position: absolute;
  left: 50%;
  top: 88rpx;
  margin-left: -3rpx;
  width: 6rpx;
  height: 12rpx;
  background: rgba(255, 255, 255, 0.92);
}
.logo-base {
  position: absolute;
  left: 50%;
  top: 100rpx;
  margin-left: -18rpx;
  width: 36rpx;
  height: 7rpx;
  border-radius: var(--r-pill);
  background: rgba(255, 255, 255, 0.92);
}
.title {
  margin-top: 30rpx;
  font-size: var(--fs-10);
  font-weight: 600;
  color: var(--t1);
  letter-spacing: 1rpx;
}

/* 底部导航预览 */
.tabs {
  display: flex;
  justify-content: center;
  margin: 32rpx 0 26rpx;
  animation: riseIn 0.5s cubic-bezier(0.22, 0.9, 0.32, 1) 0.08s backwards;
}
.tab-chip + .tab-chip {
  margin-left: 12rpx;
}
.tab-chip {
  font-size: var(--fs-1);
  color: var(--t3);
  background: rgba(255, 255, 255, 0.86);
  border-radius: var(--r-pill);
  padding: 8rpx 18rpx;
  box-shadow: var(--sd);
}
.tab-chip.active {
  color: var(--on-brand);
  font-weight: 600;
  background: linear-gradient(135deg, var(--brand-lt), var(--brand));
  box-shadow: var(--sd-brand);
}

/* 能力卡片 */
.card {
  background: rgba(255, 255, 255, 0.94);
  border-radius: var(--r-xl);
  box-shadow: var(--sd-md);
  padding: 10rpx 24rpx;
  margin-bottom: 40rpx;
  animation: riseIn 0.5s cubic-bezier(0.22, 0.9, 0.32, 1) 0.16s backwards;
}
.feat {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.feat:last-child {
  border-bottom: none;
}
.feat-ico {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--r-lg);
  flex-shrink: 0;
  text-align: center;
  line-height: 64rpx;
  font-size: var(--fs-6);
  color: var(--on-brand);
}
.feat-ico.blue {
  background: linear-gradient(135deg, var(--brand-lt), var(--brand));
  box-shadow: var(--sd-brand);
}
.feat-ico.green {
  background: linear-gradient(135deg, var(--green-2), var(--green));
  box-shadow: var(--sd-green);
}
.feat-ico.violet {
  background: linear-gradient(135deg, var(--violet-2), var(--violet));
  box-shadow: var(--sd-violet);
}
.feat-body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}
.feat-t {
  font-size: var(--fs-5);
  font-weight: 600;
  color: var(--t1);
}
.feat-d {
  margin-top: 6rpx;
  font-size: var(--fs-2);
  color: var(--t3);
}

/* 按钮 */
.login-btn {
  width: 100%;
  height: 100rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-lg);
  background: linear-gradient(135deg, var(--green-2), var(--green));
  color: var(--on-brand);
  font-size: var(--fs-7);
  font-weight: 600;
  box-shadow: 0 14rpx 32rpx rgba(7, 193, 96, 0.3);
  animation: riseIn 0.5s cubic-bezier(0.22, 0.9, 0.32, 1) 0.24s backwards;
  transition: transform 0.18s var(--ease), box-shadow 0.18s var(--ease);
}
.login-btn::after {
  border: none;
}
.admin-btn {
  width: 100%;
  height: 92rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-lg);
  background: rgba(255, 255, 255, 0.9);
  color: var(--brand);
  font-size: var(--fs-5);
  box-shadow: var(--sd);
  animation: riseIn 0.5s cubic-bezier(0.22, 0.9, 0.32, 1) 0.34s backwards;
  transition: transform 0.18s var(--ease);
}
.admin-btn::after {
  border: none;
}
.login-press {
  transform: scale(0.975);
}
