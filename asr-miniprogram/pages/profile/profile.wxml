<view class="page {{anim}}">
  <!-- ==================== 身份卡 ==================== -->
  <view class="me">
    <view class="me-blob me-blob1"></view>
    <view class="me-blob me-blob2"></view>
    <view class="me-row">
      <view class="avatar">{{initial || '?'}}</view>
      <view class="me-main">
        <view class="me-name">{{userId || '未登录'}}</view>
        <view class="me-role">
          <text class="role-chip">{{roleText || '—'}}</text>
          <text class="me-env">{{envText}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ==================== 我的进度（采集员） ==================== -->
  <view wx:if="{{isCollector && progress && progress.total}}" class="card pcard">
    <view class="pc-head">
      <text class="pc-title">我的进度</text>
      <text class="pc-sub">{{progress.approved}} / {{progress.total}} 已通过</text>
    </view>
    <view class="pc-body">
      <view class="pc-num">{{percent}}<text class="pc-unit">%</text></view>
      <view class="pc-right">
        <view class="bar"><view class="bar-fill" style="width:{{percent}}%"></view></view>
        <view class="chips">
          <text class="chip">待录 {{progress.pending}}</text>
          <text class="chip">待审 {{progress.uploaded}}</text>
          <text class="chip ok">已通过 {{progress.approved}}</text>
          <text class="chip {{progress.rejected ? 'bad' : ''}}">已退回 {{progress.rejected}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ==================== 快捷操作 ==================== -->
  <view class="group-title">快捷操作</view>
  <view class="list">
    <view
      wx:if="{{isCollector}}"
      class="item"
      hover-class="item-press"
      hover-stay-time="60"
      bindtap="onGoRecord"
    >
      <view class="item-ico blue">◉</view>
      <view class="item-body">
        <view class="item-label">开始录音采集</view>
        <view class="item-desc">前往「语言采集」继续录制</view>
      </view>
      <view class="item-arrow">›</view>
    </view>
    <view
      wx:if="{{isManager}}"
      class="item"
      hover-class="item-press"
      hover-stay-time="60"
      bindtap="onGoReview"
    >
      <view class="item-ico green">✓</view>
      <view class="item-body">
        <view class="item-label">录音审核台</view>
        <view class="item-desc">试听并判定通过 / 退回</view>
      </view>
      <view class="item-arrow">›</view>
    </view>
    <view class="item" hover-class="item-press" hover-stay-time="60" bindtap="onGoHome">
      <view class="item-ico violet">⌂</view>
      <view class="item-body">
        <view class="item-label">我的工作台</view>
        <view class="item-desc">回到{{isManager ? '「任务管理」' : '「首页」'}}查看进度与任务</view>
      </view>
      <view class="item-arrow">›</view>
    </view>
  </view>

  <!-- ==================== 合规与隐私 ==================== -->
  <view class="group-title">合规与隐私</view>
  <view class="list">
    <view
      wx:if="{{isCollector}}"
      class="item"
      hover-class="item-press"
      hover-stay-time="60"
      bindtap="onGoConsent"
    >
      <view class="item-ico amber">§</view>
      <view class="item-body">
        <view class="item-label">语音信息同意书</view>
        <view class="item-desc">查看 / 撤回已签署的单独同意</view>
      </view>
      <view class="item-arrow">›</view>
    </view>
    <view class="item" hover-class="item-press" hover-stay-time="60" bindtap="onPrivacy">
      <view class="item-ico">ⓘ</view>
      <view class="item-body">
        <view class="item-label">隐私保护指引</view>
        <view class="item-desc">查看微信平台用户隐私保护指引</view>
      </view>
      <view class="item-arrow">›</view>
    </view>
  </view>

  <!-- ==================== 开发者（仅开发版） ==================== -->
  <block wx:if="{{canSwitch}}">
    <view class="group-title">开发者</view>
    <view class="list">
      <view class="item" hover-class="item-press" hover-stay-time="60" bindtap="onSwitchRole">
        <view class="item-ico">⇄</view>
        <view class="item-body">
          <view class="item-label">切换身份</view>
          <view class="item-desc">当前：{{roleText}}（仅开发版可见）</view>
        </view>
        <view class="item-arrow">›</view>
      </view>
    </view>
  </block>

  <button class="logout" hover-class="logout-press" bindtap="onLogout">退出登录</button>
  <view class="version">版本 {{version}} · {{envText}}</view>
</view>
