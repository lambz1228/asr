.page {
  min-height: 100vh;
  box-sizing: border-box;
  /* 拆成三条写：最后一条 calc 若被机型丢弃，仍保留固定底部留白 */
  padding: 24rpx 24rpx 0;
  padding-bottom: var(--tab-pad);
  padding-bottom: calc(var(--tab-pad) + env(safe-area-inset-bottom));
}

/* ============================ 身份卡 ============================ */
.me {
  position: relative;
  overflow: hidden;
  border-radius: var(--r-xl);
  padding: 38rpx 32rpx;
  background: linear-gradient(135deg, #2b7cff 0%, #5a86ff 48%, #7c6cff 100%);
  box-shadow: 0 16rpx 40rpx rgba(58, 108, 255, 0.28);
  margin-bottom: 22rpx;
}
.me-blob {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
}
.me-blob1 {
  width: 280rpx;
  height: 280rpx;
  right: -90rpx;
  top: -130rpx;
}
.me-blob2 {
  width: 170rpx;
  height: 170rpx;
  left: -60rpx;
  bottom: -100rpx;
  background: rgba(255, 255, 255, 0.09);
}
.me-row {
  position: relative;
  display: flex;
  align-items: center;
}
.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.94);
  color: #2b7cff;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 108rpx;
  text-align: center;
  box-shadow: 0 8rpx 22rpx rgba(20, 40, 90, 0.2);
}
.me-main {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}
.me-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.me-role {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
}
.role-chip {
  font-size: 21rpx;
  color: #fff;
  padding: 4rpx 18rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.26);
  margin-right: 14rpx;
}
.me-env {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.82);
}

/* ============================ 进度卡 ============================ */
.pcard {
  padding: 28rpx 26rpx;
  margin-bottom: 22rpx;
}
.pc-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.pc-title {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--t1);
}
.pc-sub {
  font-size: 23rpx;
  color: var(--t3);
}
.pc-body {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}
.pc-num {
  font-size: 68rpx;
  font-weight: 700;
  color: var(--brand);
  line-height: 1;
  letter-spacing: -2rpx;
}
.pc-unit {
  font-size: 26rpx;
  font-weight: 600;
  margin-left: 4rpx;
}
.pc-right {
  flex: 1;
  min-width: 0;
  margin-left: 26rpx;
}
.bar {
  height: 14rpx;
  border-radius: 8rpx;
  background: #eef1f6;
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  border-radius: 8rpx;
  transform-origin: left center;
  background: linear-gradient(90deg, #58b6ff, #1a8cff);
  animation: barGrow 0.9s cubic-bezier(0.22, 0.9, 0.32, 1) backwards;
  transition: width 0.35s var(--ease);
}
.chips {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}
.chip {
  font-size: 21rpx;
  color: var(--t2);
  background: #f4f6fa;
  padding: 5rpx 14rpx;
  border-radius: 8rpx;
  margin: 0 12rpx 12rpx 0;
}
.chip.ok {
  color: var(--green);
  background: var(--green-soft);
}
.chip.bad {
  color: var(--red);
  background: var(--red-soft);
}

/* ============================ 分组列表 ============================ */
.group-title {
  margin: 8rpx 8rpx 14rpx;
  font-size: 24rpx;
  color: var(--t3);
  letter-spacing: 1rpx;
}
.list {
  background: var(--card);
  border-radius: var(--r-lg);
  box-shadow: var(--sd);
  overflow: hidden;
  margin-bottom: 26rpx;
}
.item {
  display: flex;
  align-items: center;
  padding: 26rpx 24rpx;
  border-bottom: 1rpx solid var(--line);
  transition: background 0.16s var(--ease), transform 0.16s var(--ease);
}
.item:last-child {
  border-bottom: none;
}
.item-press {
  background: #f7f9fc;
  transform: scale(0.99);
}
.item-ico {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  text-align: center;
  line-height: 68rpx;
  font-size: 32rpx;
  color: #fff;
  background: linear-gradient(135deg, #b9c3cf, #98a4b2);
}
.item-ico.blue {
  background: linear-gradient(135deg, #4aa8ff, #1a8cff);
  box-shadow: 0 8rpx 18rpx rgba(26, 140, 255, 0.24);
}
.item-ico.green {
  background: linear-gradient(135deg, #35d07f, #07c160);
  box-shadow: 0 8rpx 18rpx rgba(7, 193, 96, 0.22);
}
.item-ico.violet {
  background: linear-gradient(135deg, #a58bff, #7c5cff);
  box-shadow: 0 8rpx 18rpx rgba(124, 92, 255, 0.22);
}
.item-ico.amber {
  background: linear-gradient(135deg, #ffb340, #ff9500);
  box-shadow: 0 8rpx 18rpx rgba(255, 149, 0, 0.22);
}
.item-body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}
.item-label {
  font-size: 29rpx;
  color: var(--t1);
}
.item-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--t3);
}
.item-arrow {
  color: var(--t4);
  font-size: 36rpx;
  margin-left: 12rpx;
}

/* ============================ 退出 ============================ */
.logout {
  margin-top: 12rpx;
  height: 96rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card);
  color: var(--red);
  font-size: 30rpx;
  border-radius: var(--r-lg);
  box-shadow: var(--sd);
  transition: transform 0.18s var(--ease), background 0.18s var(--ease);
}
.logout::after {
  border: none;
}
.logout-press {
  background: var(--red-soft);
  transform: scale(0.98);
}
.version {
  margin-top: 26rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--t4);
}
