.page {
  min-height: 100vh;
  box-sizing: border-box;
  /* 左右留白唯一来源 --page-pad-x（与分包页一致） */
  padding-top: 24rpx;
  padding-right: var(--page-pad-x);
  padding-left: var(--page-pad-x);
  /* 本页是 tab 页：底部留出 tabBar 高度。拆成两条写，
     最后一条 calc 若被机型丢弃，仍保留固定底部留白。 */
  padding-bottom: var(--tab-pad);
  padding-bottom: calc(var(--tab-pad) + env(safe-area-inset-bottom));
}

/* ============================ 身份卡 ============================ */
.me {
  position: relative;
  overflow: hidden;
  border-radius: var(--r-xl);
  padding: 38rpx 32rpx;
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-2) 48%, var(--violet) 100%);
  box-shadow: 0 16rpx 40rpx rgba(58, 108, 255, 0.28);
  margin-bottom: 22rpx;
}
.me-blob {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
}
.me-blob1 {
  width: 280rpx;
  height: 280rpx;
  right: -90rpx;
  top: -130rpx;
}
.me-blob2 {
  width: 170rpx;
  height: 170rpx;
  left: -60rpx;
  bottom: -100rpx;
  background: rgba(255, 255, 255, 0.09);
}
.me-row {
  position: relative;
  display: flex;
  align-items: center;
}
.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.94);
  color: var(--brand);
  font-size: var(--fs-10);
  font-weight: 600;
  line-height: 108rpx;
  text-align: center;
  box-shadow: var(--sd-md);
}
.me-main {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}
.me-name {
  font-size: var(--fs-8);
  font-weight: 600;
  color: var(--on-brand);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.me-role {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
}
.role-chip {
  font-size: var(--fs-1);
  color: var(--on-brand);
  padding: 4rpx 18rpx;
  border-radius: var(--r-pill);
  background: rgba(255, 255, 255, 0.26);
  margin-right: 14rpx;
}
.me-env {
  font-size: var(--fs-2);
  color: rgba(255, 255, 255, 0.82);
}

/* ============================ 进度卡 ============================ */
.pcard {
  padding: 28rpx 26rpx;
  margin-bottom: 22rpx;
}
.pc-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.pc-title {
  font-size: var(--fs-5);
  font-weight: 600;
  color: var(--t1);
}
.pc-sub {
  font-size: var(--fs-2);
  color: var(--t3);
}
.pc-body {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}
.pc-num {
  font-size: var(--fs-13);
  font-weight: 700;
  color: var(--brand);
  line-height: 1;
  letter-spacing: -2rpx;
}
.pc-unit {
  font-size: var(--fs-4);
  font-weight: 600;
  margin-left: 4rpx;
}
.pc-right {
  flex: 1;
  min-width: 0;
  margin-left: 26rpx;
}
.bar {
  height: 14rpx;
  border-radius: var(--r-xs);
  background: var(--bg);
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  border-radius: var(--r-xs);
  transform-origin: left center;
  background: linear-gradient(90deg, var(--brand-2), var(--brand));
  animation: barGrow 0.9s cubic-bezier(0.22, 0.9, 0.32, 1) backwards;
  transition: width 0.35s var(--ease);
}
.chips {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}
.chip {
  font-size: var(--fs-1);
  color: var(--t2);
  background: var(--surface-2);
  padding: 5rpx 14rpx;
  border-radius: var(--r-xs);
  margin: 0 12rpx 12rpx 0;
}
.chip.ok {
  color: var(--green);
  background: var(--green-soft);
}
.chip.bad {
  color: var(--red);
  background: var(--red-soft);
}

/* ============================ 分组列表 ============================ */
.group-title {
  margin: 8rpx 8rpx 14rpx;
  font-size: var(--fs-3);
  color: var(--t3);
  letter-spacing: 1rpx;
}
.list {
  background: var(--card);
  border-radius: var(--r-lg);
  box-shadow: var(--sd);
  overflow: hidden;
  margin-bottom: 26rpx;
}
.item {
  display: flex;
  align-items: center;
  padding: 26rpx 24rpx;
  border-bottom: 1rpx solid var(--line);
  transition: background 0.16s var(--ease), transform 0.16s var(--ease);
}
.item:last-child {
  border-bottom: none;
}
.item-press {
  background: var(--surface-2);
  transform: scale(0.99);
}
.item-ico {
  width: 68rpx;
  height: 68rpx;
  border-radius: var(--r-lg);
  flex-shrink: 0;
  text-align: center;
  line-height: 68rpx;
  font-size: var(--fs-7);
  color: var(--on-brand);
  background: linear-gradient(135deg, var(--t4), var(--t3));
}
.item-ico.blue {
  background: linear-gradient(135deg, var(--brand-lt), var(--brand));
  box-shadow: var(--sd-brand);
}
.item-ico.green {
  background: linear-gradient(135deg, var(--green-2), var(--green));
  box-shadow: var(--sd-green);
}
.item-ico.violet {
  background: linear-gradient(135deg, var(--violet-2), var(--violet));
  box-shadow: var(--sd-violet);
}
.item-ico.amber {
  background: linear-gradient(135deg, var(--amber-2), var(--amber));
  box-shadow: var(--sd-amber);
}
.item-body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}
.item-label {
  font-size: var(--fs-5);
  color: var(--t1);
}
.item-desc {
  margin-top: 6rpx;
  font-size: var(--fs-2);
  color: var(--t3);
}
.item-arrow {
  color: var(--t4);
  font-size: var(--fs-8);
  margin-left: 12rpx;
}

/* ============================ 退出 ============================ */
.logout {
  margin-top: 12rpx;
  height: 96rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card);
  color: var(--red);
  font-size: var(--fs-6);
  border-radius: var(--r-lg);
  box-shadow: var(--sd);
  transition: transform 0.18s var(--ease), background 0.18s var(--ease);
}
.logout::after {
  border: none;
}
.logout-press {
  background: var(--red-soft);
  transform: scale(0.98);
}
.version {
  margin-top: 26rpx;
  text-align: center;
  font-size: var(--fs-2);
  color: var(--t4);
}
