page {
  background: #f5f6f8;
}
.page {
  padding: 28rpx 24rpx 60rpx;
}

/* 身份卡片 */
.me-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #1a8cff, #3aa0ff);
  border-radius: 16rpx;
  padding: 34rpx 28rpx;
  box-shadow: 0 8rpx 20rpx rgba(26, 140, 255, 0.22);
}
.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  color: #1a8cff;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 104rpx;
  text-align: center;
  flex-shrink: 0;
}
.me-main {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}
.me-name {
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.me-role {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 25rpx;
}
.me-tag {
  flex-shrink: 0;
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.24);
}

/* 进度 */
.progress-card {
  background: #fff;
  border-radius: 14rpx;
  padding: 24rpx;
  margin-top: 20rpx;
}
.progress-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.progress-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}
.progress-rate {
  font-size: 24rpx;
  color: #07c160;
}
.bar {
  height: 14rpx;
  background: #eee;
  border-radius: 7rpx;
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  background: #07c160;
  border-radius: 7rpx;
  transition: width 0.3s;
}
.progress-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-top: 16rpx;
  font-size: 23rpx;
  color: #888;
}
.progress-meta .ok {
  color: #07c160;
}
.progress-meta .bad {
  color: #e64340;
}

/* 功能列表 */
.list {
  margin-top: 20rpx;
  background: #fff;
  border-radius: 14rpx;
  overflow: hidden;
}
.item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.item:last-child {
  border-bottom: none;
}
.item-label {
  font-size: 30rpx;
  color: #222;
  flex-shrink: 0;
}
.item-desc {
  flex: 1;
  text-align: right;
  margin: 0 12rpx;
  font-size: 23rpx;
  color: #9aa0a6;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.item-arrow {
  margin-left: auto;
  color: #c8ccd0;
  font-size: 32rpx;
}
.item-desc + .item-arrow {
  margin-left: 0;
}

/* 退出 */
.logout {
  margin-top: 32rpx;
  background: #fff;
  color: #e64340;
  font-size: 30rpx;
  border-radius: 14rpx;
  line-height: 2.7;
}
.logout::after {
  border: none;
}
.version {
  margin-top: 26rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b0b4b8;
}
