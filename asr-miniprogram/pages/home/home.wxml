<view class="page">
  <!-- 顶部问候：两个身份共用，仅副标题不同 -->
  <view class="hero">
    <view class="hero-title">{{greeting}}<text wx:if="{{userId}}">，{{userId}}</text></view>
    <view class="hero-sub">
      <text class="role-tag {{isManager ? 'mgr' : 'col'}}">{{roleText}}</text>
      <text>· 语音采集工作台</text>
    </view>
  </view>

  <!-- ==================== 采集员 ==================== -->
  <block wx:if="{{isCollector}}">
    <view wx:if="{{!consentSigned}}" class="notice" bindtap="onGoConsent">
      <view class="notice-title">尚未签署《语音信息同意书》</view>
      <view class="notice-body">未签署前录音上传会被拦截，点击前往签署 ›</view>
    </view>

    <!-- 我的进度 -->
    <view wx:if="{{progress && progress.total}}" class="progress-card">
      <view class="progress-head">
        <text class="progress-title">我的进度</text>
        <text class="progress-rate">{{progress.approved}}/{{progress.total}} 已通过 · {{percent}}%</text>
      </view>
      <view class="bar"><view class="bar-fill" style="width:{{percent}}%"></view></view>
      <view class="progress-meta">
        <text>待录 {{progress.pending}}</text>
        <text>待审 {{progress.uploaded}}</text>
        <text class="ok">已通过 {{progress.approved}}</text>
        <text class="{{progress.rejected ? 'bad' : ''}}">已退回 {{progress.rejected}}</text>
      </view>
    </view>

    <button class="primary-action" bindtap="onStartRecord">开始录音采集</button>

    <!-- 我的任务 -->
    <view class="section-head">
      <text class="section-title">我的任务{{pendingCount ? '（待处理 ' + pendingCount + ' 条）' : ''}}</text>
      <text
        wx:if="{{tasks.length > pendingCount}}"
        class="section-more"
        bindtap="onToggleTasks"
      >{{showAllTasks ? '只看待处理' : '全部 ' + tasks.length + ' 条 ›'}}</text>
    </view>
    <view
      wx:for="{{visibleTasks}}"
      wx:key="id"
      class="card"
      data-id="{{item.id}}"
      bindtap="onTapTask"
    >
      <view class="card-top">
        <text class="status {{item.status}}">{{statusText[item.status] || item.status}}</text>
        <text class="go">去录音 ›</text>
      </view>
      <view class="text">{{item.text}}</view>
      <view wx:if="{{item.status === 'rejected'}}" class="reject">
        <text class="reject-title">退回原因</text>
        <text class="reject-body">{{item.rejectReason || '未填写'}}，请点击重录</text>
      </view>
    </view>
    <view wx:if="{{!loading && !visibleTasks.length}}" class="tip">暂无待处理任务</view>
    <view wx:if="{{restCount}}" class="tip small">
      还有 {{restCount}} 条未展示，可进入「语言采集」按队列顺序继续录
    </view>

    <!-- 公共池 -->
    <block wx:if="{{poolTotal}}">
      <view class="section-title standalone">公共池（可领取 {{poolTotal}} 条）</view>
      <view wx:for="{{poolPreview}}" wx:key="id" class="card pool-card">
        <view class="text">{{item.text}}</view>
        <button
          class="claim-btn"
          size="mini"
          loading="{{claiming === item.id}}"
          data-id="{{item.id}}"
          bindtap="onClaim"
        >领取</button>
      </view>
      <view wx:if="{{poolTotal > 3}}" class="tip small">还有 {{poolTotal - 3}} 条未展示，可下拉刷新查看</view>
    </block>
  </block>

  <!-- ============ 管理员 / 审核员 ============ -->
  <block wx:else>
    <!-- 全局采集进度 -->
    <view class="progress-card">
      <view class="progress-head">
        <text class="progress-title">采集完成率</text>
        <text class="progress-rate">{{overall.approved || 0}}/{{overall.total || 0}} · {{overallPercent}}%</text>
      </view>
      <view class="bar"><view class="bar-fill" style="width:{{overallPercent}}%"></view></view>
      <view class="progress-meta">
        <text>待录 {{overall.pending || 0}}</text>
        <text>待审 {{overall.uploaded || 0}}</text>
        <text class="ok">已通过 {{overall.approved || 0}}</text>
        <text class="{{overall.rejected ? 'bad' : ''}}">已退回 {{overall.rejected || 0}}</text>
        <text>公共池 {{poolCount}}</text>
      </view>
    </view>

    <view class="stats">
      <view class="stat">
        <view class="num">{{overall.uploaded || 0}}</view>
        <view class="label">待审核</view>
      </view>
      <view class="stat">
        <view class="num">{{overall.recorded || 0}}</view>
        <view class="label">已采集</view>
      </view>
      <view class="stat">
        <view class="num">{{overall.total || 0}}</view>
        <view class="label">总任务</view>
      </view>
    </view>

    <!-- 管理入口 -->
    <view class="entries">
      <view wx:if="{{isAdmin}}" class="entry" bindtap="onImport">
        <view class="entry-ico import">＋</view>
        <view class="entry-body">
          <view class="entry-title">导入任务</view>
          <view class="entry-desc">上传 Excel/CSV 或粘贴文本，统一下发给采集员</view>
        </view>
        <view class="entry-arrow">›</view>
      </view>
      <view class="entry" bindtap="onReview">
        <view class="entry-ico review">✓</view>
        <view class="entry-body">
          <view class="entry-title">录音审核</view>
          <view class="entry-desc">试听录音，通过或退回{{overall.uploaded ? '（' + overall.uploaded + ' 条待审）' : ''}}</view>
        </view>
        <view class="entry-arrow">›</view>
      </view>
      <view wx:if="{{isAdmin}}" class="entry" bindtap="onAudit">
        <view class="entry-ico audit">≡</view>
        <view class="entry-body">
          <view class="entry-title">审计日志</view>
          <view class="entry-desc">查看导入 / 审核 / 导出记录，清理过期导出包</view>
        </view>
        <view class="entry-arrow">›</view>
      </view>
    </view>

    <!-- 采集员排行 -->
    <view wx:if="{{allCollectors.length}}">
      <view class="section-head">
        <text class="section-title">采集员进度</text>
        <text wx:if="{{allCollectors.length > 5}}" class="section-more" bindtap="onToggleCollectors">
          {{showAllCollectors ? '收起' : '全部 ' + allCollectors.length + ' 人 ›'}}
        </text>
      </view>
      <view class="card" wx:for="{{showAllCollectors ? allCollectors : topCollectors}}" wx:key="userId">
        <view class="col-head">
          <text class="col-id">{{item.userId}}</text>
          <text class="col-rate">{{item.approved}}/{{item.total}} · {{item.percent}}%</text>
        </view>
        <view class="bar slim"><view class="bar-fill" style="width:{{item.percent}}%"></view></view>
        <view class="col-meta">
          <text>待录 {{item.pending}}</text>
          <text>待审 {{item.uploaded}}</text>
          <text class="{{item.rejected ? 'bad' : ''}}">退回 {{item.rejected}}</text>
        </view>
      </view>
    </view>

    <!-- 任务包（仅管理员） -->
    <block wx:if="{{isAdmin}}">
      <view class="section-title standalone">任务包</view>
      <view wx:if="{{loading}}" class="tip">加载中...</view>
      <view wx:elif="{{pkgs.length === 0}}" class="tip">暂无任务包，去「导入任务」创建一个</view>
      <block wx:else>
        <view class="card" wx:for="{{pkgs}}" wx:key="pkgId">
          <view class="card-head">
            <text class="pkg-name">{{item.name}}</text>
            <text class="pkg-id">{{item.pkgId}}</text>
          </view>
          <view class="meta">
            <text>文本 {{item.texts}}</text>
            <text>任务 {{item.assignments}}</text>
            <text>待录 {{item.pending}}</text>
          </view>
        </view>
      </block>
    </block>
  </block>
</view>
