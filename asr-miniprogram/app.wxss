/* ==========================================================================
   全局设计令牌 · 动效库
   两个身份（采集员 / 管理员）共用同一套视觉语言与动画节奏
   ========================================================================== */
page {
  /* 品牌色：主色蓝（导航 / 主操作）+ 成功绿（提交 / 已通过）*/
  --brand: #1a8cff;
  --brand-2: #58b6ff;
  --brand-3: #0e6fd8;
  --brand-soft: #e9f4ff;
  --green: #07c160;
  --green-2: #35d07f;
  --green-soft: #e7f8ef;
  --amber: #ff9500;
  --amber-soft: #fff5e6;
  --red: #f0453a;
  --red-soft: #ffeeec;
  --violet: #7c5cff;
  --violet-soft: #f0ecff;

  /* 中性色 */
  --bg: #eef1f6;
  --card: #ffffff;
  /* 第二层浅面：按下态 / 弱化面板（替代散落的 #f0f2f6/#f2f4f8/#f4f6fa/#f6f8fb/#f7f9fc） */
  --surface-2: #f4f6fa;
  /* 深色底上的文字（按钮 / 徽标 / 彩色块）——与 --card 同值但语义不同 */
  --on-brand: #ffffff;
  --t1: #12171f;
  --t2: #5a6470;
  --t3: #98a1ac;
  --t4: #c3c9d1;
  --line: #edf0f4;

  /* 各色系渐变亮/暗端（与 --brand-2 / --brand-3 同一命名约定） */
  --brand-lt: #4aa8ff; /* 品牌渐变亮端（按钮 / 图标底） */
  --amber-2: #ffb340; /* 琥珀渐变亮端 */
  --amber-3: #e07f00; /* 琥珀渐变暗端 */
  --red-2: #ff7a72; /* 红色渐变亮端 */
  --red-3: #d8352b; /* 红色渐变暗端 */
  --violet-2: #a58bff; /* 紫色渐变亮端 */

  /* 琥珀「警示标签」前景/底色（替代旧色板 #b45309 / #fef3c7） */
  --amber-ink: #b45309;
  --amber-ink-soft: #fef3c7;
  /* 琥珀提示块的浅色描边（替代 #ffe2b0 / #ffe0b2 两个重复值） */
  --amber-line: #ffe2b0;
  /* 危险操作的浅色描边（替代旧色板 #f0c2c0 / #f7c9c5） */
  --red-line: #f7c9c5;

  /* 圆角 / 阴影 / 缓动 */
  --r-xs: 8rpx;
  --r-xl: 32rpx;
  --r-lg: 24rpx;
  --r-md: 18rpx;
  --r-sm: 12rpx;
  --r-pill: 999rpx;
  --sd: 0 6rpx 22rpx rgba(20, 33, 56, 0.06);
  --sd-md: 0 10rpx 30rpx rgba(20, 33, 56, 0.09);
  --sd-lg: 0 16rpx 44rpx rgba(20, 33, 56, 0.14);
  /* 品牌色光晕：主操作按钮/图标底，四色统一 offset/blur/alpha 节奏 */
  --sd-brand: 0 8rpx 20rpx rgba(26, 140, 255, 0.28);
  --sd-green: 0 8rpx 20rpx rgba(7, 193, 96, 0.24);
  --sd-violet: 0 8rpx 20rpx rgba(124, 92, 255, 0.24);
  --sd-amber: 0 8rpx 20rpx rgba(255, 149, 0, 0.26);
  --sd-red: 0 8rpx 20rpx rgba(240, 69, 58, 0.26);
  --ease: cubic-bezier(0.22, 0.9, 0.32, 1);
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);

  /* 字号阶梯：全仓只用这几档，禁止相邻 1rpx 的随手值（20/21/22/23…）
     index 按从小到大，取值即下方注释；新增档位必须补在这里并由自检护栏校验 */
  --fs-1: 20rpx; /* 极小标注 / 角标 */
  --fs-2: 22rpx; /* 元信息 / 辅助说明 */
  --fs-3: 24rpx; /* 列表副文本 */
  --fs-4: 26rpx; /* 正文 */
  --fs-5: 28rpx; /* 小标题 */
  --fs-6: 30rpx; /* 标题 */
  --fs-7: 32rpx; /* 页面主标题 */
  --fs-8: 36rpx; /* 强调数字 */
  --fs-9: 40rpx;
  --fs-10: 44rpx; /* 大标题 / 空态 */
  --fs-11: 48rpx;
  --fs-12: 56rpx;
  --fs-13: 68rpx; /* 进度大数字 */
  --fs-14: 76rpx;
  --fs-15: 96rpx;

  /* 统一水平边距：所有页面左右留白都用它，避免 20/24/26rpx 混用 */
  --page-pad-x: 24rpx;

  /* 自定义 tabBar 尺寸（页面底部留白的唯一来源，见 .tab-pad） */
  --tabbar-h: 108rpx;
  --tab-pad: 190rpx;

  background: var(--bg);
  color: var(--t1);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* ============================== 动画关键帧 ============================== */
/* 卡片/区块入场：上浮 + 轻微放大 */
@keyframes riseIn {
  from {
    opacity: 0;
    transform: translate3d(0, 30rpx, 0) scale(0.985);
  }
  to {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
  }
}
@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
@keyframes popIn {
  0% {
    opacity: 0;
    transform: scale(0.82);
  }
  62% {
    opacity: 1;
    transform: scale(1.05);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}
/* 进度条从左侧生长 */
@keyframes barGrow {
  from {
    transform: scaleX(0);
  }
  to {
    transform: scaleX(1);
  }
}
/* 未录制时录音键的呼吸光晕 */
@keyframes breathe {
  0%,
  100% {
    transform: scale(1);
    opacity: 0.5;
  }
  50% {
    transform: scale(1.14);
    opacity: 0.14;
  }
}
/* 录制中向外扩散的波纹 */
@keyframes ripple {
  0% {
    transform: scale(0.78);
    opacity: 0.5;
  }
  100% {
    transform: scale(1.85);
    opacity: 0;
  }
}
/* 录制中律动波形条 */
@keyframes wave {
  0%,
  100% {
    transform: scaleY(0.28);
  }
  50% {
    transform: scaleY(1);
  }
}
/* 骨架屏微光 */
@keyframes skPulse {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.5;
  }
}
/* 折叠面板展开 */
@keyframes slideDown {
  from {
    opacity: 0;
    transform: translate3d(0, -14rpx, 0);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
/* 徽标脉冲（待处理提醒） */
@keyframes pulseDot {
  0%,
  100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.35);
  }
}

/* ============================== 通用工具类 ============================== */
/* 交错入场：容器内每个直接子 view 依次上浮出现（最多 12 项递进）
   注意 fill-mode 用 backwards 而非 both —— 动画结束后不锁定 transform，
   否则卡片自身的 hover-class 按压缩放会被动画残留样式盖掉。 */
.stagger > view {
  animation: riseIn 0.46s cubic-bezier(0.22, 0.9, 0.32, 1) backwards;
}
.stagger > view:nth-child(1) {
  animation-delay: 0.02s;
}
.stagger > view:nth-child(2) {
  animation-delay: 0.06s;
}
.stagger > view:nth-child(3) {
  animation-delay: 0.1s;
}
.stagger > view:nth-child(4) {
  animation-delay: 0.14s;
}
.stagger > view:nth-child(5) {
  animation-delay: 0.18s;
}
.stagger > view:nth-child(6) {
  animation-delay: 0.22s;
}
.stagger > view:nth-child(7) {
  animation-delay: 0.26s;
}
.stagger > view:nth-child(8) {
  animation-delay: 0.3s;
}
.stagger > view:nth-child(9) {
  animation-delay: 0.34s;
}
.stagger > view:nth-child(10) {
  animation-delay: 0.38s;
}
.stagger > view:nth-child(11) {
  animation-delay: 0.42s;
}
.stagger > view:nth-child(n + 12) {
  animation-delay: 0.46s;
}

.rise {
  animation: riseIn 0.46s cubic-bezier(0.22, 0.9, 0.32, 1) backwards;
}
.pop {
  animation: popIn 0.42s cubic-bezier(0.22, 0.9, 0.32, 1) backwards;
}
.fade {
  animation: fadeIn 0.36s cubic-bezier(0.22, 0.9, 0.32, 1) backwards;
}

/* 通用卡片 */
.card {
  background: var(--card);
  border-radius: var(--r-lg);
  box-shadow: var(--sd);
}

/* 按压反馈（配合 hover-class="press"） */
.press {
  transform: scale(0.975);
  opacity: 0.92;
}

/* 骨架屏
   用 opacity 脉冲，而不是 background-position 扫光 —— 后者每帧都要重绘整块渐变，
   页面上同时出现 2~3 个骨架块时（首页 / 审核台）会明显掉帧；opacity 走合成层。 */
.sk {
  background: #e6ebf2;
  border-radius: var(--r-sm);
  animation: skPulse 1.2s ease-in-out infinite;
}

/* tab 页底部留白：避开自定义 tabBar 与全面屏安全区
   注意：calc() 里混用 % 与 rpx 在部分机型 / 基础库上会被整条丢掉，
   甚至让 flex 换行计算失真，所以这里只混用同为长度的 rpx 与 env()，
   并保留一条不依赖 env() 的兜底声明。 */
.tab-pad {
  padding-bottom: var(--tab-pad);
  padding-bottom: calc(var(--tab-pad) + env(safe-area-inset-bottom));
}

/* 空态 */
.empty-ico-wrap {
  width: 168rpx;
  height: 168rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: linear-gradient(160deg, #ffffff, #e8eef7);
  box-shadow: var(--sd-md);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: popIn 0.5s cubic-bezier(0.22, 0.9, 0.32, 1) both;
}

/* 按钮通用：去默认边框 + 按压缩放 */
button::after {
  border: none;
}
.btn-tap {
  transition: transform 0.16s var(--ease), box-shadow 0.16s var(--ease);
}
.btn-tap.press {
  transform: scale(0.97);
}
