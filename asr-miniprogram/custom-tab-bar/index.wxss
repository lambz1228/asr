/* 自定义 tabBar：与页面同一套视觉语言（白色毛玻璃底 + 滑动高亮块） */
.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  height: 108rpx;
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  align-items: stretch;
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid rgba(20, 33, 56, 0.07);
  box-shadow: 0 -8rpx 28rpx rgba(20, 33, 56, 0.07);
}

/* 高亮块：宽 132rpx，left 为项中心百分比，用 margin-left 居中 */
.blob {
  position: absolute;
  top: 12rpx;
  width: 132rpx;
  height: 84rpx;
  margin-left: -66rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, rgba(26, 140, 255, 0.18), rgba(88, 182, 255, 0.1));
  box-shadow: 0 6rpx 18rpx rgba(26, 140, 255, 0.18);
  transition: left 0.4s cubic-bezier(0.22, 0.9, 0.32, 1);
  pointer-events: none;
}

.item {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.ico-wrap {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.34s cubic-bezier(0.22, 0.9, 0.32, 1);
}

.ico {
  width: 46rpx;
  height: 46rpx;
}

.txt {
  margin-top: 2rpx;
  font-size: 20rpx;
  line-height: 1.2;
  color: #9aa0a6;
  transition: color 0.28s ease, font-weight 0.28s ease;
}

/* 选中态：图标弹跳放大 + 文案变蓝加粗 */
.item.on .ico-wrap {
  transform: scale(1.08);
  animation: tabPop 0.42s cubic-bezier(0.22, 0.9, 0.32, 1) backwards;
}
.item.on .txt {
  color: #1a8cff;
  font-weight: 600;
}

@keyframes tabPop {
  0% {
    transform: scale(0.86);
  }
  55% {
    transform: scale(1.18) translateY(-4rpx);
  }
  100% {
    transform: scale(1.06) translateY(0);
  }
}
