/* 自定义 tabBar：与页面同一套视觉语言（白色底 + 滑动高亮块）
   性能注意：
   1. 不要用 backdrop-filter: blur() —— 全宽固定元素实时高斯模糊在 Android 上
      是知名掉帧点（每帧都要重取背景并模糊），切 tab / 滚动时尤其明显。
      这里用不透明底色 + 细上边线就够了。
   2. 高亮块滑动必须走 transform（合成层），不能用 left（每帧触发重排）。 */
.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  height: 108rpx;
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  align-items: stretch;
  background: #ffffff;
  border-top: 1rpx solid rgba(20, 33, 56, 0.07);
  box-shadow: 0 -4rpx 16rpx rgba(20, 33, 56, 0.05);
}

/* 高亮块轨道：宽 = 1/4 栏宽，translateX(i * 100%) 即第 i 项中心 */
.blob-track {
  position: absolute;
  top: 0;
  left: 0;
  width: 25%;
  height: 100%;
  pointer-events: none;
  /* 提升为合成层：过渡期间不参与重排 / 重绘 */
  will-change: transform;
  /* 过渡只在「点击离场」时被用到（anim=true），那一段滑动很快会被页面切换打断，
     所以时长偏短，让指向感利落一点；到位由目标页首帧保证，不靠这段动画。 */
  transition: transform 0.28s cubic-bezier(0.22, 0.9, 0.32, 1);
}

/* 瞬移模式（首帧 / 页面重新显示时纠正位置）：
   禁掉过渡，高亮块「一帧到位」。这是「导航跟不上」的关键 ——
   一旦这里带着过渡，就会出现「页面已切换、高亮块还在滑」的滞后感。 */
.blob-track.no-anim {
  transition: none;
}

/* 高亮块：固定在轨道中心 */
.blob {
  position: absolute;
  top: 12rpx;
  left: 50%;
  width: 132rpx;
  height: 84rpx;
  margin-left: -66rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, rgba(26, 140, 255, 0.18), rgba(88, 182, 255, 0.1));
  box-shadow: 0 6rpx 18rpx rgba(26, 140, 255, 0.18);
}

.item {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.ico-wrap {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.34s cubic-bezier(0.22, 0.9, 0.32, 1);
}

.ico {
  width: 46rpx;
  height: 46rpx;
}

/* 只过渡颜色：font-weight 过渡会触发文字重新排版（每帧 layout），去掉 */
.txt {
  margin-top: 2rpx;
  font-size: 20rpx;
  line-height: 1.2;
  color: #9aa0a6;
  transition: color 0.28s ease;
}

/* 选中态：图标弹跳放大 + 文案变蓝加粗。
   animation-fill-mode 用 backwards：结束后回到静态 transform。
   所以 100% 的关键帧必须与 .item.on .ico-wrap 的静态值一致（都是 scale(1.08)），
   否则动画收尾会从 1.06 跳到 1.08 —— 切页最后那一下的轻微抖动就是这么来的。 */
.item.on .ico-wrap {
  transform: scale(1.08);
  animation: tabPop 0.42s cubic-bezier(0.22, 0.9, 0.32, 1) backwards;
}
.item.on .txt {
  color: #1a8cff;
  font-weight: 600;
}

@keyframes tabPop {
  0% {
    transform: scale(0.86);
  }
  55% {
    transform: scale(1.18) translateY(-4rpx);
  }
  100% {
    transform: scale(1.08) translateY(0);
  }
}
