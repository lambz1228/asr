<view class="bar">
  <!-- 活动项高亮块：整体走 transform 过渡（合成层，不触发重排），
       track 宽 = 1/4 栏宽，第 i 项即 translateX(i * 100%) -->
  <view class="blob-track" style="transform: translateX({{blobIdx * 100}}%)">
    <view class="blob"></view>
  </view>

  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="item {{selected === index ? 'on' : ''}}"
    data-i="{{index}}"
    bindtap="onTap"
  >
    <view class="ico-wrap">
      <image class="ico" src="{{selected === index ? item.activeIcon : item.icon}}" mode="aspectFit" />
    </view>
    <view class="txt">{{item.text}}</view>
  </view>
</view>
