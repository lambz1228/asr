/* ==========================================================================
   导入任务 —— 与采集端共用 app.wxss 设计令牌
   本页是分包页（navigateTo 打开，没有底部 tabBar），底部留白只叠加安全区。
   ========================================================================== */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-top: 24rpx;
  padding-right: var(--page-pad-x);
  padding-bottom: 30rpx;
  padding-left: var(--page-pad-x);
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  background: var(--bg);
}

/* ------------------------------ 分段控件 ------------------------------ */
.tabs {
  display: flex;
  background: var(--card);
  border-radius: var(--r-lg);
  box-shadow: var(--sd);
  padding: 10rpx;
  margin-bottom: 20rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: var(--fs-5);
  color: var(--t2);
  border-radius: var(--r-md);
  transition: background 0.25s var(--ease), color 0.25s var(--ease);
}
.tab.on {
  background: linear-gradient(135deg, var(--brand-lt), var(--brand));
  color: var(--on-brand);
  box-shadow: var(--sd-brand);
  font-weight: 600;
}

/* ------------------------------ 表单 ------------------------------ */
.form {
  background: var(--card);
  border-radius: var(--r-lg);
  box-shadow: var(--sd);
  padding: 8rpx 24rpx;
}
.field {
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.field:last-child {
  border-bottom: none;
}
.field-row {
  display: flex;
}
.field-row > view + view {
  margin-left: 20rpx;
}
.field-row .field {
  border-bottom: none;
}
.field.half {
  flex: 1;
}
.label {
  font-size: var(--fs-2);
  color: var(--t3);
}
.input {
  margin-top: 8rpx;
  font-size: var(--fs-6);
  color: var(--t1);
}
.picker {
  color: var(--t1);
}

.hint {
  margin: 22rpx 8rpx 12rpx;
  font-size: var(--fs-2);
  line-height: 1.6;
  color: var(--t3);
}

/* ------------------------------ 采集员下发 ------------------------------ */
.card {
  background: var(--card);
  border-radius: var(--r-lg);
  box-shadow: var(--sd);
  padding: 8rpx 24rpx 4rpx;
  margin-top: 20rpx;
}
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 18rpx;
}
.card-title {
  font-size: var(--fs-5);
  font-weight: 600;
  color: var(--t1);
}
.links {
  display: flex;
}
.links > text + text {
  margin-left: 24rpx;
}
.link {
  font-size: var(--fs-3);
  color: var(--brand);
}
.users {
  display: flex;
  flex-direction: column;
  margin: 6rpx 0 4rpx;
}
.user-item {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.user-name {
  font-size: var(--fs-5);
  color: var(--t1);
}
.distribute {
  border-top: 1rpx solid var(--line);
}
.textarea {
  width: 100%;
  box-sizing: border-box;
  height: 360rpx;
  background: var(--card);
  border-radius: var(--r-lg);
  box-shadow: var(--sd);
  padding: 22rpx;
  font-size: var(--fs-5);
  line-height: 1.7;
}

/* ------------------------------ 文件选择 ------------------------------ */
.file-picker {
  background: var(--card);
  border: 2rpx dashed var(--t4);
  border-radius: var(--r-lg);
  box-shadow: var(--sd);
  padding: 60rpx 24rpx;
  text-align: center;
}
.file-name {
  font-size: var(--fs-5);
  color: var(--t1);
  word-break: break-all;
}
.file-tip {
  margin-top: 12rpx;
  font-size: var(--fs-2);
  color: var(--t3);
}

/* ------------------------------ 提交 ------------------------------ */
.submit {
  margin-top: 30rpx;
  height: 96rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-lg);
  font-size: var(--fs-7);
  font-weight: 600;
  background: linear-gradient(135deg, var(--green-2), var(--green));
  color: var(--on-brand);
  box-shadow: var(--sd-green);
  transition: transform 0.16s var(--ease);
}
.submit::after {
  border: none;
}

/* ------------------------------ 导入结果 ------------------------------ */
.result {
  margin-top: 30rpx;
  background: var(--card);
  border-radius: var(--r-lg);
  box-shadow: var(--sd);
  padding: 26rpx;
}
.result-title {
  font-size: var(--fs-6);
  font-weight: 600;
  color: var(--green);
  margin-bottom: 16rpx;
}
.result-rows {
  display: flex;
  flex-direction: column;
  font-size: var(--fs-4);
  color: var(--t2);
}
.result-rows > text + text {
  margin-top: 10rpx;
}
.errs {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
}
.errs > text + text {
  margin-top: 8rpx;
}
.err {
  font-size: var(--fs-2);
  color: var(--amber-ink);
  background: var(--amber-ink-soft);
  padding: 8rpx 14rpx;
  border-radius: var(--r-sm);
}
