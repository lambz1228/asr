.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 20rpx 20rpx 30rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  background: #f5f5f5;
}

.tabs {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 10rpx;
}
.tab.on {
  background: #07c160;
  color: #fff;
}

.form {
  background: #fff;
  border-radius: 14rpx;
  padding: 8rpx 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.field {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f2f2f2;
}
.field:last-child {
  border-bottom: none;
}
.field-row {
  display: flex;
}
.field-row > view + view {
  margin-left: 20rpx;
}
.field-row .field {
  border-bottom: none;
}
.field.half {
  flex: 1;
}
.label {
  font-size: 24rpx;
  color: #999;
}
.input {
  margin-top: 8rpx;
  font-size: 30rpx;
  color: #222;
}
.picker {
  color: #222;
}

.hint {
  margin: 22rpx 8rpx 12rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #999;
}

.card {
  background: #fff;
  border-radius: 14rpx;
  padding: 8rpx 24rpx 4rpx;
  margin-top: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 18rpx;
}
.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}
.links {
  display: flex;
}
.links > text + text {
  margin-left: 24rpx;
}
.link {
  font-size: 24rpx;
  color: #07c160;
}
.users {
  display: flex;
  flex-direction: column;
  margin: 6rpx 0 4rpx;
}
.user-item {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.user-name {
  font-size: 28rpx;
  color: #333;
}
.distribute {
  border-top: 1rpx solid #f2f2f2;
}
.textarea {
  width: 100%;
  box-sizing: border-box;
  height: 360rpx;
  background: #fff;
  border-radius: 14rpx;
  padding: 22rpx;
  font-size: 28rpx;
  line-height: 1.7;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.file-picker {
  background: #fff;
  border: 2rpx dashed #cfd8e3;
  border-radius: 14rpx;
  padding: 60rpx 24rpx;
  text-align: center;
}
.file-name {
  font-size: 29rpx;
  color: #333;
  word-break: break-all;
}
.file-tip {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #aaa;
}

.submit {
  margin-top: 30rpx;
  background: #07c160;
  color: #fff;
  font-size: 30rpx;
}
.submit::after {
  border: none;
}

.result {
  margin-top: 30rpx;
  background: #fff;
  border-radius: 14rpx;
  padding: 26rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.result-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #07c160;
  margin-bottom: 16rpx;
}
.result-rows {
  display: flex;
  flex-direction: column;
  font-size: 26rpx;
  color: #555;
}
.result-rows > text + text {
  margin-top: 10rpx;
}
.errs {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
}
.errs > text + text {
  margin-top: 8rpx;
}
.err {
  font-size: 23rpx;
  color: #b45309;
  background: #fef3c7;
  padding: 8rpx 14rpx;
  border-radius: 10rpx;
}

/* ============ 统一视觉主题：与底部导航一致的圆角 / 阴影 / 品牌色 ============ */
.page {
  background: var(--bg);
}
.tabs {
  border-radius: var(--r-lg);
  box-shadow: var(--sd);
  padding: 10rpx;
}
.tab {
  border-radius: var(--r-md);
  color: var(--t2);
  transition: background 0.25s var(--ease), color 0.25s var(--ease);
}
.tab.on {
  background: linear-gradient(135deg, #2b8cff, #58b6ff);
  box-shadow: 0 8rpx 20rpx rgba(26, 140, 255, 0.28);
  font-weight: 600;
}
.form,
.card,
.textarea,
.file-picker,
.result {
  background: var(--card);
  border-radius: var(--r-lg);
  box-shadow: var(--sd);
}
.label {
  color: var(--t3);
  font-size: 23rpx;
}
.input,
.picker,
.user-name,
.file-name {
  color: var(--t1);
}
.card-title,
.result-title {
  color: var(--t1);
}
.result-title {
  color: var(--green);
}
.link {
  color: var(--brand);
}
.hint {
  color: var(--t3);
}
.file-picker {
  border: 2rpx dashed #cbd5e1;
}
.err {
  border-radius: var(--r-sm);
}
.submit {
  height: 96rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-lg);
  font-size: 31rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #20d47a, #07c160);
  box-shadow: 0 12rpx 28rpx rgba(7, 193, 96, 0.28);
  transition: transform 0.16s var(--ease);
}
