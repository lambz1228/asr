<view class="page stagger">
  <view class="tabs">
    <view class="tab {{mode==='paste'?'on':''}}" data-m="paste" bindtap="switchMode">粘贴文本</view>
    <view class="tab {{mode==='file'?'on':''}}" data-m="file" bindtap="switchMode">上传文件</view>
  </view>

  <view class="form">
    <view class="field">
      <text class="label">任务包 ID</text>
      <input class="input" placeholder="留空自动生成" value="{{pkgId}}" data-k="pkgId" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="label">任务包名称</text>
      <input class="input" placeholder="留空用任务包 ID" value="{{name}}" data-k="name" bindinput="onInput" />
    </view>
    <view class="field-row">
      <view class="field half">
        <text class="label">采样率</text>
        <input class="input" type="number" value="{{sampleRate}}" data-k="sampleRate" bindinput="onInput" />
      </view>
      <view class="field half">
        <text class="label">声道</text>
        <input class="input" type="number" value="{{channels}}" data-k="channels" bindinput="onInput" />
      </view>
      <view class="field half">
        <text class="label">格式</text>
        <picker range="{{formats}}" value="{{formatIndex}}" bindchange="onFormat">
          <view class="input picker">{{format}}</view>
        </picker>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-head">
      <text class="card-title">下发给</text>
      <view class="links">
        <text class="link" bindtap="onSelectAll">全选</text>
        <text class="link" bindtap="onClearAll">清空</text>
      </view>
    </view>
    <view class="hint">勾选后任务直接下发到该采集员的「我的任务」；不勾选则进入公共池，由采集员自行领取</view>
    <checkbox-group class="users" bindchange="onSelectUsers">
      <label class="user-item" wx:for="{{users}}" wx:key="userId">
        <checkbox value="{{item.userId}}" checked="{{item.checked}}" color="#07c160" />
        <text class="user-name">{{item.userId}}</text>
      </label>
    </checkbox-group>
    <view wx:if="{{!users.length}}" class="hint">暂无采集员账号（需先有用户以采集员身份登录过）</view>

    <view class="field distribute">
      <text class="label">分配方式</text>
      <picker range="{{distributeLabels}}" value="{{distributeIndex}}" bindchange="onDistribute">
        <view class="input picker">{{distributeLabels[distributeIndex]}}</view>
      </picker>
    </view>
  </view>

  <!-- 方式一：粘贴文本 -->
  <block wx:if="{{mode==='paste'}}">
    <view class="hint">每行一条待录制文本，空行自动忽略</view>
    <textarea
      class="textarea"
      placeholder="今天天气真好，我们一起去公园散步吧。&#10;请朗读这一段新闻：本地气温将明显下降。"
      value="{{text}}"
      data-k="text"
      bindinput="onInput"
      maxlength="-1"
    />
    <button class="submit" hover-class="press" loading="{{loading}}" bindtap="onSubmitPaste">导入并下发</button>
  </block>

  <!-- 方式二：上传文件 -->
  <block wx:else>
    <view class="hint">支持 Excel（.xlsx 两列：序号 / 汉语文本）与 CSV、JSON；「序号」列自动忽略</view>
    <view class="file-picker" bindtap="onChooseFile">
      <view class="file-name">{{fileName || '点击选择 Excel / CSV / JSON 文件'}}</view>
      <view class="file-tip">从聊天记录中选取（可先发到「文件传输助手」）</view>
    </view>
    <button class="submit" hover-class="press" loading="{{loading}}" bindtap="onSubmitFile">上传并下发</button>
  </block>

  <!-- 导入结果 -->
  <view wx:if="{{result}}" class="result">
    <view class="result-title">导入完成</view>
    <view class="result-rows">
      <text>任务包：{{result.pkgId}}</text>
      <text>新增文本：{{result.createdTexts}}</text>
      <text>新增子任务：{{result.createdAssignments}}</text>
      <text>下发对象：{{result.assignees.length ? result.assignees : '公共池（自行领取）'}}</text>
      <text wx:if="{{result.assignees.length}}">分配方式：{{result.distribute === 'all' ? '每人一份' : '轮流分摊'}}</text>
      <text>跳过：{{result.skipped}}</text>
    </view>
    <view wx:if="{{result.errors.length}}" class="errs">
      <text wx:for="{{result.errors}}" wx:key="*this" class="err">{{item}}</text>
    </view>
  </view>
</view>
