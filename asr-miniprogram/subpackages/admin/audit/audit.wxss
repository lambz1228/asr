/* ==========================================================================
   审计日志 —— 与采集端共用 app.wxss 设计令牌
   本页是分包页（navigateTo 打开，没有底部 tabBar），底部留白只叠加安全区，
   因此不使用 --tab-pad；水平留白统一走 --page-pad-x（=24rpx，与采集端一致）。
   ========================================================================== */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  /* 拆成长写：即使 calc 那条被机型丢弃，固定留白仍在；也不让整条简写失效 */
  padding-top: 24rpx;
  padding-right: var(--page-pad-x);
  padding-bottom: 30rpx;
  padding-left: var(--page-pad-x);
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  background: var(--bg);
}

/* ------------------------------ 顶部标题栏 ------------------------------ */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 4rpx 18rpx;
}
.topbar-title {
  font-size: var(--fs-6);
  font-weight: 600;
  color: var(--t1);
}
.clean-btn {
  margin: 0;
  background: var(--card);
  color: var(--brand);
  font-size: var(--fs-3);
  border-radius: var(--r-md);
  box-shadow: var(--sd);
  transition: transform 0.16s var(--ease);
}
.clean-btn::after {
  border: none;
}

/* ------------------------------ 操作类型筛选 ------------------------------ */
.tabs {
  white-space: nowrap;
  margin-bottom: 16rpx;
}
.tab {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-right: 14rpx;
  border-radius: var(--r-pill);
  background: var(--card);
  color: var(--t2);
  font-size: var(--fs-3);
  box-shadow: var(--sd);
  transition: background 0.25s var(--ease), color 0.25s var(--ease);
}
.tab.on {
  /* 与采集端主操作同一套品牌渐变（见 home/profile/login 的 .btn-primary） */
  background: linear-gradient(135deg, var(--brand-lt), var(--brand));
  color: var(--on-brand);
  font-weight: 600;
}

/* ------------------------------ 导出任务留存 ------------------------------ */
.jobs-toggle {
  margin: 6rpx 4rpx 14rpx;
  font-size: var(--fs-2);
  color: var(--brand);
}
.job {
  background: var(--card);
  border-radius: var(--r-lg);
  box-shadow: var(--sd);
  padding: 20rpx 22rpx;
  margin-bottom: 12rpx;
}
.job-line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.job-id {
  font-size: var(--fs-3);
  color: var(--t2);
  font-family: monospace;
}
.job-status {
  font-size: var(--fs-2);
  color: var(--t3);
}
.job-status.done {
  color: var(--green);
}
.job-status.failed {
  color: var(--red);
}
.job-status.expired {
  color: var(--t4);
}
.job-meta {
  display: flex;
  flex-wrap: wrap;
  margin-top: 10rpx;
  font-size: var(--fs-2);
  color: var(--t3);
}
.job-meta > text {
  margin: 0 20rpx 8rpx 0;
}
.job-meta .bad {
  color: var(--red);
}

/* ------------------------------ 日志卡片 ------------------------------ */
.card {
  background: var(--card);
  border-radius: var(--r-lg);
  box-shadow: var(--sd);
  padding: 22rpx 24rpx;
  margin-bottom: 16rpx;
}
.card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.action {
  font-size: var(--fs-5);
  font-weight: 600;
  color: var(--t1);
}
.time {
  font-size: var(--fs-2);
  color: var(--t3);
}
.who {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}
.who > text + text {
  margin-left: 14rpx;
}
.operator {
  font-size: var(--fs-3);
  color: var(--t2);
}
.role {
  font-size: var(--fs-1);
  color: var(--brand);
  background: var(--brand-soft);
  border-radius: var(--r-sm);
  padding: 2rpx 12rpx;
}
.target {
  margin-top: 10rpx;
  font-size: var(--fs-2);
  color: var(--t3);
  word-break: break-all;
}
.detail {
  margin-top: 10rpx;
  font-size: var(--fs-2);
  color: var(--t3);
  line-height: 1.5;
  word-break: break-all;
}

/* ------------------------------ 空态 / 分页 ------------------------------ */
.tip {
  text-align: center;
  color: var(--t3);
  margin-top: 60rpx;
  font-size: var(--fs-4);
}
.tip.small {
  margin-top: 20rpx;
  font-size: var(--fs-2);
}
.more {
  text-align: center;
  color: var(--brand);
  font-size: var(--fs-3);
  padding: 22rpx 0;
}
.more.done {
  color: var(--t4);
}
