<view class="page">
  <view class="hero">
    <view class="hero-title">管理台</view>
    <view class="hero-sub">{{roleText}}<text wx:if="{{userId}}"> · {{userId}}</text></view>
  </view>

  <!-- 全局采集进度 -->
  <view class="progress-card">
    <view class="progress-head">
      <text class="progress-title">采集完成率</text>
      <text class="progress-rate">{{overall.approved || 0}}/{{overall.total || 0}} · {{percent}}%</text>
    </view>
    <view class="bar"><view class="bar-fill" style="width:{{percent}}%"></view></view>
    <view class="progress-meta">
      <text>待录 {{overall.pending || 0}}</text>
      <text>待审 {{overall.uploaded || 0}}</text>
      <text class="ok">已通过 {{overall.approved || 0}}</text>
      <text class="{{overall.rejected ? 'bad' : ''}}">已退回 {{overall.rejected || 0}}</text>
      <text>公共池 {{pool}}</text>
    </view>
  </view>

  <view class="stats">
    <view class="stat">
      <view class="num">{{overall.uploaded || 0}}</view>
      <view class="label">待审核</view>
    </view>
    <view class="stat">
      <view class="num">{{overall.recorded || 0}}</view>
      <view class="label">已采集</view>
    </view>
    <view class="stat">
      <view class="num">{{overall.total || 0}}</view>
      <view class="label">总任务</view>
    </view>
  </view>

  <view class="entries">
    <view wx:if="{{isAdmin}}" class="entry" bindtap="onImport">
      <view class="entry-ico import">＋</view>
      <view class="entry-body">
        <view class="entry-title">导入任务</view>
        <view class="entry-desc">上传 Excel/CSV 或粘贴文本，统一下发给采集员</view>
      </view>
      <view class="entry-arrow">›</view>
    </view>
    <view class="entry" bindtap="onReview">
      <view class="entry-ico review">✓</view>
      <view class="entry-body">
        <view class="entry-title">录音审核</view>
        <view class="entry-desc">试听录音，通过或退回{{overall.uploaded ? '（' + overall.uploaded + ' 条待审）' : ''}}</view>
      </view>
      <view class="entry-arrow">›</view>
    </view>
  </view>

  <!-- 采集员排行 -->
  <view wx:if="{{allCollectors.length}}" class="collectors">
    <view class="section-head">
      <text class="section-title">采集员进度</text>
      <text wx:if="{{allCollectors.length > 5}}" class="section-more" bindtap="onToggleCollectors">
        {{showAll ? '收起' : '全部 ' + allCollectors.length + ' 人 ›'}}
      </text>
    </view>
    <view class="card" wx:for="{{showAll ? allCollectors : topCollectors}}" wx:key="userId">
      <view class="col-head">
        <text class="col-id">{{item.userId}}</text>
        <text class="col-rate">{{item.approved}}/{{item.total}} · {{item.percent}}%</text>
      </view>
      <view class="bar slim"><view class="bar-fill" style="width:{{item.percent}}%"></view></view>
      <view class="col-meta">
        <text>待录 {{item.pending}}</text>
        <text>待审 {{item.uploaded}}</text>
        <text class="{{item.rejected ? 'bad' : ''}}">退回 {{item.rejected}}</text>
      </view>
    </view>
  </view>

  <block wx:if="{{isAdmin}}">
    <view class="section-title standalone">任务包</view>
    <view wx:if="{{loading}}" class="tip">加载中...</view>
    <view wx:elif="{{pkgs.length === 0}}" class="tip">暂无任务包，去「导入任务」创建一个</view>
    <block wx:else>
      <view class="card" wx:for="{{pkgs}}" wx:key="pkgId">
        <view class="card-head">
          <text class="pkg-name">{{item.name}}</text>
          <text class="pkg-id">{{item.pkgId}}</text>
        </view>
        <view class="meta">
          <text>文本 {{item.texts}}</text>
          <text>任务 {{item.assignments}}</text>
          <text>待录 {{item.pending}}</text>
        </view>
      </view>
    </block>
  </block>

  <button class="logout" bindtap="onLogout">退出登录</button>
</view>
