.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 20rpx calc(30rpx + env(safe-area-inset-bottom));
  background: #f5f5f5;
}

.hero {
  padding: 8rpx 8rpx 24rpx;
}
.hero-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.hero-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

/* 全局进度 */
.progress-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.progress-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.progress-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}
.progress-rate {
  font-size: 24rpx;
  color: #07c160;
}
.bar {
  height: 14rpx;
  background: #eee;
  border-radius: 7rpx;
  overflow: hidden;
}
.bar.slim {
  height: 10rpx;
}
.bar-fill {
  height: 100%;
  background: #07c160;
  border-radius: 7rpx;
  transition: width 0.3s;
}
.progress-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 22rpx;
  margin-top: 16rpx;
  font-size: 23rpx;
  color: #888;
}
.progress-meta .ok {
  color: #07c160;
}
.progress-meta .bad {
  color: #e64340;
}

/* 采集员排行 */
.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 26rpx 8rpx 14rpx;
}
.section-head .section-title {
  margin: 0;
}
.section-more {
  font-size: 23rpx;
  color: #1989fa;
}
.section-title.standalone {
  margin: 26rpx 8rpx 14rpx;
}
.col-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.col-id {
  font-size: 27rpx;
  font-weight: 600;
  color: #222;
}
.col-rate {
  font-size: 23rpx;
  color: #07c160;
}
.col-meta {
  display: flex;
  gap: 24rpx;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #888;
}
.col-meta .bad {
  color: #e64340;
}

.stats {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 26rpx 0;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.stat {
  flex: 1;
  text-align: center;
}
.stat .num {
  font-size: 40rpx;
  font-weight: 600;
  color: #07c160;
}
.stat .label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999;
}

.entries {
  margin-top: 20rpx;
}
.entry {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.entry-ico {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  color: #fff;
  font-size: 40rpx;
  line-height: 72rpx;
  text-align: center;
  margin-right: 22rpx;
  flex-shrink: 0;
}
.entry-ico.import {
  background: #1989fa;
}
.entry-ico.review {
  background: #07c160;
}
.entry-body {
  flex: 1;
  min-width: 0;
}
.entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}
.entry-desc {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #999;
}
.entry-arrow {
  color: #ccc;
  font-size: 36rpx;
  margin-left: 12rpx;
}

.section-title {
  margin: 26rpx 8rpx 14rpx;
  font-size: 26rpx;
  color: #666;
}

.card {
  background: #fff;
  border-radius: 14rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 14rpx;
}
.pkg-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}
.pkg-id {
  font-size: 22rpx;
  color: #bbb;
}
.meta {
  display: flex;
  gap: 28rpx;
  font-size: 24rpx;
  color: #666;
}

.tip {
  text-align: center;
  color: #999;
  margin-top: 60rpx;
  font-size: 26rpx;
}

.logout {
  margin-top: 40rpx;
  background: #fff;
  color: #e64340;
  font-size: 28rpx;
}
.logout::after {
  border: none;
}
