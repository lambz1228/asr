.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 16rpx 20rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #f5f5f5;
}

.topbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.tabs {
  flex: 1;
  white-space: nowrap;
}
.tab {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 12rpx;
  background: #fff;
  color: #666;
  font-size: 26rpx;
  border-radius: 28rpx;
}
.tab.on {
  background: #07c160;
  color: #fff;
}
.export-btn {
  background: #fff;
  color: #07c160;
  border: 1rpx solid #07c160;
  font-size: 24rpx;
}

.card {
  background: #fff;
  border-radius: 14rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}
.rid {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}
.badge {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  color: #fff;
}
.badge.uploaded {
  background: #ff976a;
}
.badge.approved {
  background: #07c160;
}
.badge.rejected {
  background: #e64340;
}

.meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 24rpx;
  font-size: 24rpx;
  color: #666;
}
.flags {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.flag {
  font-size: 22rpx;
  color: #b45309;
  background: #fef3c7;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}
.actions {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.play-btn {
  background: #1989fa;
  color: #fff;
}
.ok-btn {
  background: #07c160;
  color: #fff;
}
.no-btn {
  background: #fff;
  color: #e64340;
  border: 1rpx solid #f0c2c0;
}
.reviewed {
  font-size: 24rpx;
  color: #999;
}

.tip {
  text-align: center;
  color: #999;
  margin-top: 80rpx;
  font-size: 26rpx;
}
