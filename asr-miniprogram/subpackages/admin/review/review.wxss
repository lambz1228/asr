.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 16rpx 20rpx 20rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #f5f5f5;
}

.topbar {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.topbar > view + view,
.topbar > text + text,
.topbar > button + button {
  margin-left: 16rpx;
}
.tabs {
  flex: 1;
  white-space: nowrap;
}
.tab {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 12rpx;
  background: #fff;
  color: #666;
  font-size: 26rpx;
  border-radius: 28rpx;
}
.tab.on {
  background: #07c160;
  color: #fff;
}
.export-btn {
  background: #fff;
  color: #07c160;
  border: 1rpx solid #07c160;
  font-size: 24rpx;
}

.card {
  background: #fff;
  border-radius: 14rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}
.rid {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}
.badge {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  color: #fff;
}
.badge.uploaded {
  background: #ff976a;
}
.badge.approved {
  background: #07c160;
}
.badge.rejected {
  background: #e64340;
}

.meta {
  display: flex;
  flex-wrap: wrap;
  font-size: 24rpx;
  color: #666;
}
.meta > text {
  margin: 0 24rpx 12rpx 0;
}
.flags {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
}
.flags > text {
  margin-right: 10rpx;
}
.flag {
  font-size: 22rpx;
  color: #b45309;
  background: #fef3c7;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}
.actions {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
}
.actions > view + view,
.actions > text + text,
.actions > button + button {
  margin-left: 14rpx;
}
.play-btn {
  background: #1989fa;
  color: #fff;
}
.ok-btn {
  background: #07c160;
  color: #fff;
}
.no-btn {
  background: #fff;
  color: #e64340;
  border: 1rpx solid #f0c2c0;
}
.reviewed {
  font-size: 24rpx;
  color: #999;
}

.tip {
  text-align: center;
  color: #999;
  margin-top: 80rpx;
  font-size: 26rpx;
}

/* ============ 统一视觉主题：与底部导航一致的圆角 / 阴影 / 品牌色 ============ */
.page {
  background: var(--bg);
}
.tab {
  color: var(--t2);
  box-shadow: var(--sd);
  transition: background 0.25s var(--ease), color 0.25s var(--ease);
}
.tab.on {
  background: linear-gradient(135deg, #2b8cff, #58b6ff);
  box-shadow: 0 8rpx 20rpx rgba(26, 140, 255, 0.26);
  font-weight: 600;
}
.export-btn {
  color: var(--brand);
  border-color: var(--brand);
}
.card {
  border-radius: var(--r-lg);
  box-shadow: var(--sd);
}
.rid {
  color: var(--t1);
}
.badge {
  font-weight: 600;
}
.play-btn,
.ok-btn,
.no-btn {
  border-radius: var(--r-md);
  transition: transform 0.16s var(--ease);
}
.play-btn {
  background: linear-gradient(135deg, #4aa8ff, #1a8cff);
  box-shadow: 0 8rpx 18rpx rgba(26, 140, 255, 0.24);
}
.ok-btn {
  background: linear-gradient(135deg, #35d07f, #07c160);
  box-shadow: 0 8rpx 18rpx rgba(7, 193, 96, 0.22);
}
.no-btn {
  color: var(--red);
  border-color: #f7c9c5;
}
.flag {
  border-radius: var(--r-sm);
}

/* ============ 列表分页渲染：骨架屏 / 计数 / 加载更多 ============ */
.sk-wrap {
  padding: 4rpx 0;
}
.sk-card {
  height: 220rpx;
  margin-bottom: 16rpx;
}
.count-tip {
  text-align: center;
  color: var(--t3);
  font-size: 23rpx;
  margin: 8rpx 0 16rpx;
}
.more-row {
  display: flex;
  justify-content: center;
  padding: 8rpx 0 24rpx;
}
.more-btn {
  color: var(--brand);
  background: var(--brand-soft);
  border-radius: var(--r-md);
  font-size: 26rpx;
  padding: 0 40rpx;
}
