/* ==========================================================================
   审核台 —— 与采集端共用 app.wxss 设计令牌
   本页是分包页（navigateTo 打开，没有底部 tabBar），底部留白只叠加安全区。
   ========================================================================== */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-top: 24rpx;
  padding-right: var(--page-pad-x);
  padding-bottom: 30rpx;
  padding-left: var(--page-pad-x);
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  background: var(--bg);
}

/* ------------------------------ 顶部筛选 / 导出 ------------------------------ */
.topbar {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
/* flex gap 在 iOS 13- 不支持，用兄弟元素 margin 兜住 */
.topbar > view + view,
.topbar > text + text,
.topbar > button + button {
  margin-left: 16rpx;
}
.tabs {
  flex: 1;
  white-space: nowrap;
}
.tab {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 12rpx;
  border-radius: var(--r-pill);
  background: var(--card);
  color: var(--t2);
  font-size: var(--fs-4);
  box-shadow: var(--sd);
  transition: background 0.25s var(--ease), color 0.25s var(--ease);
}
.tab.on {
  background: linear-gradient(135deg, var(--brand-lt), var(--brand));
  color: var(--on-brand);
  box-shadow: var(--sd-brand);
  font-weight: 600;
}
.export-btn {
  background: var(--card);
  color: var(--brand);
  border: 1rpx solid var(--brand);
  border-radius: var(--r-md);
  font-size: var(--fs-3);
}

/* ------------------------------ 录音卡片 ------------------------------ */
.card {
  background: var(--card);
  border-radius: var(--r-lg);
  box-shadow: var(--sd);
  padding: 24rpx;
  margin-bottom: 18rpx;
}
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}
.rid {
  font-size: var(--fs-6);
  font-weight: 600;
  color: var(--t1);
}
.badge {
  font-size: var(--fs-2);
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: var(--r-pill);
  color: var(--on-brand);
}
.badge.uploaded {
  background: var(--amber);
}
.badge.approved {
  background: var(--green);
}
.badge.rejected {
  background: var(--red);
}

.meta {
  display: flex;
  flex-wrap: wrap;
  font-size: var(--fs-3);
  color: var(--t2);
}
.meta > text {
  margin: 0 24rpx 12rpx 0;
}
.flags {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
}
.flags > text {
  margin-right: 10rpx;
}
.flag {
  font-size: var(--fs-2);
  color: var(--amber-ink);
  background: var(--amber-ink-soft);
  padding: 4rpx 12rpx;
  border-radius: var(--r-sm);
}

/* ------------------------------ 操作按钮 ------------------------------ */
.actions {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
}
.actions > view + view,
.actions > text + text,
.actions > button + button {
  margin-left: 14rpx;
}
.play-btn,
.ok-btn,
.no-btn {
  border-radius: var(--r-md);
  transition: transform 0.16s var(--ease);
}
.play-btn {
  background: linear-gradient(135deg, var(--brand-lt), var(--brand));
  color: var(--on-brand);
  box-shadow: var(--sd-brand);
}
.ok-btn {
  background: linear-gradient(135deg, var(--green-2), var(--green));
  color: var(--on-brand);
  box-shadow: var(--sd-green);
}
.no-btn {
  background: var(--card);
  color: var(--red);
  border: 1rpx solid var(--red-line);
}
.reviewed {
  font-size: var(--fs-3);
  color: var(--t3);
}
.tip {
  text-align: center;
  color: var(--t3);
  margin-top: 80rpx;
  font-size: var(--fs-4);
}

/* ------------------------------ 分页渲染：骨架屏 / 计数 / 加载更多 ------------- */
.sk-wrap {
  padding: 4rpx 0;
}
.sk-card {
  height: 220rpx;
  margin-bottom: 16rpx;
}
.count-tip {
  text-align: center;
  color: var(--t3);
  font-size: var(--fs-2);
  margin: 8rpx 0 16rpx;
}
.more-row {
  display: flex;
  justify-content: center;
  padding: 8rpx 0 24rpx;
}
.more-btn {
  color: var(--brand);
  background: var(--brand-soft);
  border-radius: var(--r-md);
  font-size: var(--fs-4);
  padding: 0 40rpx;
}
